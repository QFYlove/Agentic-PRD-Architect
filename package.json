{
  "name": "agentic-prd-architect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "lint": "eslint . --ext .astro,.ts,.tsx --max-warnings 0",
    "typecheck": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:repeat": "node scripts/run-e2e.mjs e2e/happy-path.spec.ts --repeat-each=3",
    "playwright:install": "playwright install chromium",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,mjs,cjs,ts}\" \"contracts/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,mjs,cjs,ts}\" \"contracts/**/*.json\""
  },
  "dependencies": {
    "@astrojs/node": "8.3.4",
    "@astrojs/react": "3.6.3",
    "@astrojs/tailwind": "5.1.4",
    "astro": "4.16.18",
    "lucide-react": "0.468.0",
    "mermaid": "10.9.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.3",
    "recharts": "2.15.0",
    "remark-gfm": "4.0.0",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@playwright/test": "1.49.1",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "eslint-plugin-astro": "1.3.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
