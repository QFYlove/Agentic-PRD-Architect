+async def test_sqlite_retention_eviction_deletes_events_at_runtime(
+    tmp_path: Path,
+) -> None:
+    """Evicting a run via retention must drop its persisted events immediately."""
+    database_path = str(tmp_path / "sqlite-eviction.sqlite3")
+    manager = make_sqlite_manager(
+        database_path=database_path,
+        settings=make_settings(max_retained_runs=1),
+    )
+    first = await manager.create_run(
+        CreateRunRequest(user_idea="Build the first sqlite retention run.")
+    )
+    await manager.wait_for_completion(first.run_id, wait_seconds=5)
+
+    second = await manager.create_run(
+        CreateRunRequest(user_idea="Build the second sqlite retention run.")
+    )
+    await manager.wait_for_completion(second.run_id, wait_seconds=5)
+
+    with pytest.raises(RunNotFoundError):
+        await manager.get_run(first.run_id)
+    with pytest.raises(RunNotFoundError):
+        manager.event_store.latest_sequence(first.run_id)
+
+    assert (
+        manager.event_store._connection.execute(
+            "SELECT COUNT(*) FROM run_events WHERE run_id = ?",
+            (str(first.run_id),),
+        ).fetchone()[0]
+        == 0
+    )
+    await manager.shutdown()
diff --git a/backend/tests/test_run_store.py b/backend/tests/test_run_store.py
index 6ac12e3..f58d335 100644
--- a/backend/tests/test_run_store.py
+++ b/backend/tests/test_run_store.py
@@ -221,3 +221,71 @@ async def test_load_keeps_all_runs_when_history_fits_under_the_cap(
     assert set(await restored.run_ids()) == {snap.run_id for snap in created}
     assert await restored.make_room() == []
     await restored.close()
+
+
+async def test_cleanup_uses_updated_at_for_long_running_runs() -> None:
+    """A run created long ago but finished recently must not expire early."""
+    now = datetime(2026, 7, 26, tzinfo=UTC)
+    clock = [now]
+    store = InMemoryRunStore(
+        max_runs=5,
+        ttl_seconds=60,
+        now=lambda: clock[0],
+    )
+    run = snapshot(RunStatus.COMPLETED)
+    run.created_at = now - timedelta(days=30)
+    run.updated_at = now
+    await store.create(run)
+    clock[0] += timedelta(seconds=31)
+
+    expired = await store.cleanup_expired()
+    assert expired == []
+
+    clock[0] += timedelta(seconds=30)
+    expired = await store.cleanup_expired()
+    assert expired == [run.run_id]
+
+
+async def test_sqlite_recovery_is_persisted_and_idempotent(tmp_path: Path) -> None:
+    """Interrupted runs recovered on startup must stay stable across restarts."""
+    database_path = str(tmp_path / "recovery.sqlite3")
+    store = SQLiteRunStore(
+        database_path=database_path,
+        max_runs=5,
+        ttl_seconds=60,
+    )
+    active = snapshot(RunStatus.GENERATING)
+    active.active_node = "generator"
+    await store.create(active)
+    await store.close()
+
+    first = SQLiteRunStore(
+        database_path=database_path,
+        max_runs=5,
+        ttl_seconds=60,
+    )
+    recovered = await first.get(active.run_id)
+    assert recovered.status is RunStatus.FAILED
+    assert recovered.error is not None
+    assert recovered.error.code == "RUN_INTERRUPTED"
+    # The database row itself must now reflect the failed state.
+    row = first._connection.execute(
+        "SELECT snapshot_json FROM runs WHERE run_id = ?",
+        (str(active.run_id),),
+    ).fetchone()
+    assert row is not None
+    persisted = RunSnapshot.model_validate_json(row[0])
+    assert persisted.status is RunStatus.FAILED
+    await first.close()
+
+    # A second restart must not re-recover the run.
+    second = SQLiteRunStore(
+        database_path=database_path,
+        max_runs=5,
+        ttl_seconds=60,
+    )
+    again = await second.get(active.run_id)
+    assert again.status is RunStatus.FAILED
+    assert again.completed_at == recovered.completed_at
+    assert again.updated_at == recovered.updated_at
+    await second.close()
