+async def test_cleanup_ttl_counts_from_last_update_not_creation() -> None:
+    """A long-running run that only just finished must survive its full TTL.
+
+    TTL is measured from the last meaningful state update, not from creation:
+    a run created hours ago but updated moments before cleanup has not expired,
+    while a run whose last update is older than the TTL has.
+    """
+    now = datetime(2026, 7, 26, tzinfo=UTC)
+    clock = [now]
+    store = InMemoryRunStore(max_runs=5, ttl_seconds=60, now=lambda: clock[0])
+
+    just_finished = snapshot(RunStatus.COMPLETED)
+    just_finished.created_at = now - timedelta(hours=5)
+    just_finished.updated_at = now - timedelta(seconds=10)
+
+    stale = snapshot(RunStatus.COMPLETED)
+    stale.created_at = now - timedelta(hours=5)
+    stale.updated_at = now - timedelta(seconds=120)
+
+    await store.create(just_finished)
+    await store.create(stale)
+
+    expired = await store.cleanup_expired()
+
+    assert expired == [stale.run_id]
+    assert (await store.get(just_finished.run_id)).status is RunStatus.COMPLETED
+
+
