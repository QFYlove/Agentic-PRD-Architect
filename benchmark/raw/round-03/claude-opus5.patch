+async def test_ttl_cleanup_deletes_persisted_events_of_removed_run(
+    tmp_path: Path,
+) -> None:
+    """A run removed by TTL must leave no persisted events or ghost stream.
+
+    Cleanup removes the run from the store; the associated event rows and the
+    in-memory stream state must go with it, so nothing can replay or subscribe
+    to a run the store no longer knows about.
+    """
+    from datetime import timedelta
+
+    from backend.errors import RunNotFoundError
+    from backend.schemas import utc_now
+
+    database_path = str(tmp_path / "ttl-events.sqlite3")
+    manager = make_sqlite_manager(
+        database_path=database_path,
+        settings=make_settings(database_path=database_path, run_ttl_seconds=60),
+    )
+    created = await manager.create_run(
+        CreateRunRequest(user_idea="Build a TTL event cleanup product.")
+    )
+    await manager.wait_for_completion(created.run_id, wait_seconds=10)
+
+    # The finished run has persisted, replayable events before cleanup.
+    assert manager.event_store.latest_sequence(created.run_id) > 0
+    persisted_before = manager.event_store._connection.execute(
+        "SELECT COUNT(*) FROM run_events WHERE run_id = ?",
+        (str(created.run_id),),
+    ).fetchone()[0]
+    assert persisted_before > 0
+
+    manager.run_store._now = lambda: utc_now() + timedelta(seconds=61)
+    expired = await manager.cleanup_once()
+
+    assert expired == [created.run_id]
+    # No ghost in-memory stream state remains.
+    assert created.run_id not in manager.event_store._events
+    assert created.run_id not in manager.event_store._conditions
+    with pytest.raises(RunNotFoundError):
+        manager.event_store.latest_sequence(created.run_id)
+    # The persisted event rows are gone too -- no invalid resource references.
+    persisted_after = manager.event_store._connection.execute(
+        "SELECT COUNT(*) FROM run_events WHERE run_id = ?",
+        (str(created.run_id),),
+    ).fetchone()[0]
+    assert persisted_after == 0
+
+    manager.event_store.close()
+    await manager.run_store.close()
