+async def test_interruption_recovery_is_persisted_and_stable_across_restarts(
+    tmp_path: Path,
+) -> None:
+    """Recovered interruption state must be durable, not re-derived every boot.
+
+    The first restart turns an interrupted run into a persisted FAILED run. A
+    second restart must load that terminal state verbatim -- it must not run
+    recovery again, which would resurface the run as a fresh interruption and
+    reset its completed_at/updated_at timestamps.
+    """
+    database_path = str(tmp_path / "stable-recovery.sqlite3")
+    store = SQLiteRunStore(database_path=database_path, max_runs=5, ttl_seconds=60)
+    active = snapshot(RunStatus.GENERATING)
+    active.active_node = "generator"
+    await store.create(active)
+    await store.close()
+
+    first = SQLiteRunStore(database_path=database_path, max_runs=5, ttl_seconds=60)
+    recovered = await first.get(active.run_id)
+    assert recovered.status is RunStatus.FAILED
+    # The recovery result is written straight back to the row, so the stored
+    # snapshot is already terminal before the next boot ever reads it.
+    stored_json = first._connection.execute(
+        "SELECT snapshot_json FROM runs WHERE run_id = ?",
+        (str(active.run_id),),
+    ).fetchone()[0]
+    assert RunSnapshot.model_validate_json(stored_json).status is RunStatus.FAILED
+    await first.close()
+
+    second = SQLiteRunStore(database_path=database_path, max_runs=5, ttl_seconds=60)
+    reloaded = await second.get(active.run_id)
+
+    assert reloaded.status is RunStatus.FAILED
+    assert reloaded.error is not None
+    assert reloaded.error.code == "RUN_INTERRUPTED"
+    # Timestamps are unchanged: no second recovery ran on the second boot.
+    assert reloaded.completed_at == recovered.completed_at
+    assert reloaded.updated_at == recovered.updated_at
+    await second.close()
+
