+@dataclass(frozen=True)
+class ModelPricing:
+    """Per-model USD price rates, backend-only.
+
+    Scoped to one model rather than a provider or a global default: two models
+    under one provider can cost different amounts, and a run must never be
+    billed with another model's rates. A configured ``0`` is a real price; an
+    absent pricing is ``None`` and reads as unknown, never as free.
+    """
+
+    input_price_per_million: Decimal
+    output_price_per_million: Decimal
+
+
 def estimate_cost(
     usage: TokenUsage,
-    settings: Settings,
     *,
+    pricing: ModelPricing | None,
     is_mock: bool,
 ) -> float | None:
     if is_mock:
         return 0.0
-    if not settings.has_model_pricing:
+    if pricing is None:
         return None
-    assert settings.model_input_price_per_million is not None
-    assert settings.model_output_price_per_million is not None
-    cost = Decimal(
-        usage.input_tokens
-    ) * settings.model_input_price_per_million / Decimal(1_000_000) + Decimal(
-        usage.output_tokens
-    ) * settings.model_output_price_per_million / Decimal(1_000_000)
+    cost = (
+        Decimal(usage.input_tokens) * pricing.input_price_per_million
+        + Decimal(usage.output_tokens) * pricing.output_price_per_million
+    ) / Decimal(1_000_000)
     return float(cost.quantize(Decimal("0.000001"), rounding=ROUND_HALF_UP))
