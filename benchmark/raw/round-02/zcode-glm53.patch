--- /dev/null
+++ b/e2e/provider-selection.spec.ts
@@ -0,0 +1,164 @@
+import { expect, test } from "@playwright/test";
+
+import {
+  getSnapshot,
+  PODCAST_IDEA,
+  setScenario,
+  startRun,
+  waitForStatus,
+} from "./helpers";
+
+test.beforeEach(async ({ request }) => {
+  await setScenario(request, "happy");
+});
+
+test("A run created through the selectors shows the selection it was created with", async ({
+  page,
+  request,
+}) => {
+  const runId = await startRun(page, { modelId: "mock-prd-lite" });
+
+  await waitForStatus(page, "已完成");
+  await expect(page.getByTestId("run-model-selection")).toHaveText(
+    "模型：Mock Provider · Mock PRD (lite)",
+  );
+
+  await page.getByTestId("workspace-tab-trace").click();
+  await expect(page.getByTestId("selected-model")).toContainText(
+    "Mock Provider · Mock PRD (lite)",
+  );
+
+  const snapshot = await getSnapshot(request, runId);
+  expect(snapshot.provider_id).toBe("mock");
+  expect(snapshot.provider_display_name).toBe("Mock Provider");
+  expect(snapshot.model_id).toBe("mock-prd-lite");
+  expect(snapshot.model_display_name).toBe("Mock PRD (lite)");
+});
+
+test("Two runs with different selections each keep their own metadata", async ({
+  page,
+  request,
+}) => {
+  const liteRun = await startRun(page, {
+    idea: `${PODCAST_IDEA}（轻量模型版本）`,
+    modelId: "mock-prd-lite",
+  });
+  await waitForStatus(page, "已完成");
+  await expect(page.getByTestId("run-model-selection")).toHaveText(
+    "模型：Mock Provider · Mock PRD (lite)",
+  );
+
+  await page.getByRole("button", { name: "新建对话" }).click();
+  const standardRun = await startRun(page, {
+    idea: `${PODCAST_IDEA}（标准模型版本）`,
+    modelId: "mock-prd",
+  });
+  await waitForStatus(page, "已完成");
+  await expect(page.getByTestId("run-model-selection")).toHaveText(
+    "模型：Mock Provider · Mock PRD (standard)",
+  );
+
+  // Navigating back to the first run shows its own persisted selection, not
+  // the other run's and not the currently selected catalog entry.
+  await page
+    .getByRole("button", { name: new RegExp("轻量模型版本") })
+    .first()
+    .click();
+  await expect
+    .poll(() => new URL(page.url()).searchParams.get("run_id"))
+    .toBe(liteRun);
+  await expect(page.getByTestId("run-model-selection")).toHaveText(
+    "模型：Mock Provider · Mock PRD (lite)",
+  );
+
+  const liteSnapshot = await getSnapshot(request, liteRun);
+  const standardSnapshot = await getSnapshot(request, standardRun);
+  expect(liteSnapshot.model_id).toBe("mock-prd-lite");
+  expect(standardSnapshot.model_id).toBe("mock-prd");
+});
+
+test("A failed or empty catalog blocks creating a new run", async ({
+  page,
+}) => {
+  await page.route("**/api/providers", async (route) => {
+    await route.fulfill({
+      status: 500,
+      contentType: "application/json",
+      body: JSON.stringify({
+        error: { code: "INTERNAL_ERROR", message: "boom", request_id: "e2e" },
+      }),
+    });
+  });
+  await page.goto("/");
+
+  await expect(page.getByTestId("catalog-error")).toBeVisible();
+  const createButton = page.getByRole("button", { name: /开始生成 PRD/ });
+  await expect(createButton).toBeDisabled();
+
+  // Recovery: the retry reloads the catalog and creation becomes possible
+  // again with a real selection.
+  await page.unroute("**/api/providers");
+  await page.getByRole("button", { name: /重试加载/ }).click();
+  await expect(page.getByTestId("provider-select")).toBeVisible();
+  await expect(createButton).toBeDisabled();
+  await page.getByTestId("provider-select").selectOption("mock");
+  await page.getByTestId("model-select").selectOption("mock-prd");
+  await expect(createButton).toBeEnabled();
+});
+
+test("An empty catalog explains itself and keeps create disabled", async ({
+  page,
+}) => {
+  await page.route("**/api/providers", async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: "application/json",
+      body: JSON.stringify({ providers: [] }),
+    });
+  });
+  await page.goto("/");
+
+  await expect(page.getByTestId("catalog-empty")).toBeVisible();
+  await expect(
+    page.getByRole("button", { name: /开始生成 PRD/ }),
+  ).toBeDisabled();
+});
+
+test("A rejected selection surfaces the backend error and is never swapped client-side", async ({
+  page,
+}) => {
+  // Rewrite the outgoing create request to carry a stale model id, standing in
+  // for a selection the backend no longer accepts (no DOM surgery involved).
+  await page.route("**/api/runs", async (route) => {
+    const request = route.request();
+    if (request.method() !== "POST") {
+      await route.continue();
+      return;
+    }
+    const body = JSON.parse(request.postData() ?? "{}");
+    body.model_id = "stale-model";
+    await route.continue({ postData: JSON.stringify(body) });
+  });
+
+  await page.goto("/");
+  const providerSelect = page.getByTestId("provider-select");
+  await expect(providerSelect).toBeEnabled();
+  await providerSelect.selectOption("mock");
+  await page.getByTestId("model-select").selectOption("mock-prd");
+
+  await page.getByLabel("产品想法").fill(PODCAST_IDEA);
+  const createResponse = page.waitForResponse(
+    (response) =>
+      response.url().endsWith("/api/runs") &&
+      response.request().method() === "POST",
+  );
+  await page.getByRole("button", { name: "开始生成 PRD" }).click();
+
+  const response = await createResponse;
+  expect(response.status()).toBe(422);
+  // The failure is shown, and the client keeps the pair the user chose
+  // instead of silently selecting a different model.
+  await expect(page.getByRole("alert")).toContainText(/重新选择|不可用/);
+  await expect(page.getByTestId("model-select")).toHaveValue("mock-prd");
+  expect(new URL(page.url()).searchParams.get("run_id")).toBeNull();
+});
