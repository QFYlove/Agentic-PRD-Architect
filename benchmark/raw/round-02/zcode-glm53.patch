+++ b/backend/provider_catalog.py
@@ -0,0 +1,314 @@
+"""Backend-controlled registry of selectable providers and models.
+
+The catalog is the single authority for what a new run may choose. Entries
+carry two disjoint kinds of data:
+
+- safe, serialized fields (ids and display names) that ``GET /api/providers``
+  returns to the frontend;
+- execution configuration (the bound :class:`LLMProvider` instance and the
+  model's pricing) that never leaves the backend.
+
+Construction failures surface as errors; nothing in this module invents a
+default entry to paper over missing configuration.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from typing import Any
+
+from backend.config import Settings
+from backend.errors import (
+    ProviderSelectionError,
+    ProviderSelectionUnavailableError,
+    ProviderUnavailableError,
+)
+from backend.providers.base import LLMProvider
+from backend.providers.compatible import OpenAICompatibleLLMProvider
+from backend.providers.mock import MockLLMProvider
+from backend.providers.scenario import ScenarioController, ScenarioMockLLMProvider
+from backend.schemas import (
+    ModelCatalogEntry,
+    ProviderCatalogEntry,
+    ProviderCatalogResponse,
+)
+from backend.telemetry import ModelPricing
+
+MOCK_PROVIDER_ID = "mock"
+MOCK_PROVIDER_DISPLAY_NAME = "Mock Provider"
+MOCK_MODEL_ID = "mock-prd"
+MOCK_MODEL_DISPLAY_NAME = "Mock PRD (standard)"
+MOCK_LITE_MODEL_ID = "mock-prd-lite"
+MOCK_LITE_MODEL_DISPLAY_NAME = "Mock PRD (lite)"
+
+REAL_PROVIDER_DISPLAY_NAMES: dict[str, str] = {
+    "deepseek": "DeepSeek",
+    "glm": "GLM",
+}
+
+
+@dataclass(frozen=True)
+class RunExecution:
+    """The provider binding one run's model calls must use.
+
+    Resolved per run (from its persisted ids) rather than from mutable global
+    "current provider" state, so concurrent runs with different selections
+    cannot cross-talk. Pricing belongs to the selected model alone: another
+    model's rates are never a fallback, and ``pricing=None`` reads as an
+    unknown cost rather than a free one.
+    """
+
+    provider: LLMProvider
+    is_mock: bool
+    pricing: ModelPricing | None
+
+
+@dataclass(frozen=True)
+class CatalogModel:
+    model_id: str
+    model_display_name: str
+    provider: LLMProvider
+    pricing: ModelPricing | None = None
+    capabilities: dict[str, Any] | None = None
+
+    def execution(self) -> RunExecution:
+        return RunExecution(
+            provider=self.provider,
+            is_mock=self.provider.is_mock,
+            pricing=self.pricing,
+        )
+
+
+@dataclass(frozen=True)
+class CatalogProvider:
+    provider_id: str
+    provider_display_name: str
+    models: tuple[CatalogModel, ...]
+
+
+@dataclass(frozen=True)
+class ResolvedSelection:
+    """One validated ``provider_id + model_id`` pair, ready to bind to a run."""
+
+    provider_id: str
+    provider_display_name: str
+    model_id: str
+    model_display_name: str
+    execution: RunExecution
+
+
+class ProviderCatalog:
+    """A read-only registry; sharing one instance across runs is safe."""
+
+    def __init__(self, providers: Sequence[CatalogProvider] = ()) -> None:
+        self._ordered: tuple[CatalogProvider, ...] = tuple(providers)
+        by_id: dict[str, CatalogProvider] = {}
+        for entry in self._ordered:
+            if entry.provider_id in by_id:
+                raise ValueError(f"Duplicate provider id: {entry.provider_id}")
+            by_id[entry.provider_id] = entry
+        self._by_id = by_id
+
+    def response(self) -> ProviderCatalogResponse:
+        """The safe wire shape: ids, display names, capabilities. Nothing else."""
+        return ProviderCatalogResponse(
+            providers=[
+                ProviderCatalogEntry(
+                    provider_id=entry.provider_id,
+                    provider_display_name=entry.provider_display_name,
+                    models=[
+                        ModelCatalogEntry(
+                            model_id=model.model_id,
+                            model_display_name=model.model_display_name,
+                            capabilities=(
+                                dict(model.capabilities)
+                                if model.capabilities is not None
+                                else None
+                            ),
+                        )
+                        for model in entry.models
+                    ],
+                )
+                for entry in self._ordered
+            ]
+        )
+
+    def resolve(self, provider_id: str, model_id: str) -> ResolvedSelection:
+        """Validate an explicit selection, or refuse it without substituting."""
+        entry = self._by_id.get(provider_id)
+        if entry is None:
+            raise ProviderSelectionError(f"Unknown provider: {provider_id}")
+        for model in entry.models:
+            if model.model_id == model_id:
+                return ResolvedSelection(
+                    provider_id=entry.provider_id,
+                    provider_display_name=entry.provider_display_name,
+                    model_id=model.model_id,
+                    model_display_name=model.model_display_name,
+                    execution=model.execution(),
+                )
+        if any(
+            model.model_id == model_id
+            for other in self._ordered
+            if other.provider_id != provider_id
+            for model in other.models
+        ):
+            raise ProviderSelectionError(
+                f"Model {model_id} does not belong to provider {provider_id}."
+            )
+        raise ProviderSelectionError(
+            f"Unknown model {model_id} under provider {provider_id}."
+        )
+
+    def resolve_default(self) -> ResolvedSelection:
+        """The legacy default: the first provider's first model.
+
+        Only requests that predate the explicit selection fields take this
+        path, and it still resolves to one concrete pair before any execution
+        so the choice can be persisted with the run.
+        """
+        for entry in self._ordered:
+            if entry.models:
+                model = entry.models[0]
+                return ResolvedSelection(
+                    provider_id=entry.provider_id,
+                    provider_display_name=entry.provider_display_name,
+                    model_id=model.model_id,
+                    model_display_name=model.model_display_name,
+                    execution=model.execution(),
+                )
+        raise ProviderSelectionError("No provider is currently selectable.")
+
+    def resolve_execution(self, provider_id: str, model_id: str) -> RunExecution:
+        """Re-resolve a persisted selection for further model execution.
+
+        Distinct from readability: the historical metadata on the snapshot
+        stays readable forever, while a run that must still call a model fails
+        loudly when its selection no longer resolves.
+        """
+        try:
+            return self.resolve(provider_id, model_id).execution
+        except ProviderSelectionError as exc:
+            raise ProviderSelectionUnavailableError() from exc
+
+
+@dataclass(frozen=True)
+class DefaultCatalogBuild:
+    catalog: ProviderCatalog
+    provider: LLMProvider
+    scenario_controller: ScenarioController | None
+
+
+def default_catalog(provider: LLMProvider, settings: Settings) -> ProviderCatalog:
+    """Wrap an already-constructed provider as a selectable catalog.
+
+    The mock branch lists two models so the local/no-key experience still
+    exercises selection; both share the same deterministic mock pipeline.
+    """
+    if provider.is_mock:
+        return ProviderCatalog(
+            (
+                CatalogProvider(
+                    provider_id=MOCK_PROVIDER_ID,
+                    provider_display_name=MOCK_PROVIDER_DISPLAY_NAME,
+                    models=(
+                        CatalogModel(
+                            model_id=MOCK_MODEL_ID,
+                            model_display_name=MOCK_MODEL_DISPLAY_NAME,
+                            provider=provider,
+                        ),
+                        CatalogModel(
+                            model_id=MOCK_LITE_MODEL_ID,
+                            model_display_name=MOCK_LITE_MODEL_DISPLAY_NAME,
+                            provider=provider,
+                        ),
+                    ),
+                ),
+            )
+        )
+    provider_id = settings.llm_provider
+    model_id = (
+        settings.deepseek_model if provider_id == "deepseek" else settings.glm_model
+    )
+    return ProviderCatalog(
+        (
+            CatalogProvider(
+                provider_id=provider_id,
+                provider_display_name=REAL_PROVIDER_DISPLAY_NAMES[provider_id],
+                models=(
+                    CatalogModel(
+                        model_id=model_id,
+                        model_display_name=model_id,
+                        provider=provider,
+                        pricing=settings.model_pricing(),
+                    ),
+                ),
+            ),
+        )
+    )
+
+
+def _real_provider_from_settings(settings: Settings) -> OpenAICompatibleLLMProvider:
+    if settings.llm_provider == "deepseek":
+        api_key = settings.deepseek_api_key
+        base_url = settings.deepseek_base_url
+        model = settings.deepseek_model
+    else:
+        api_key = settings.glm_api_key
+        base_url = settings.glm_base_url
+        model = settings.glm_model
+    if api_key is None:
+        raise ProviderUnavailableError
+    return OpenAICompatibleLLMProvider(
+        provider_name=settings.llm_provider,
+        api_key=api_key.get_secret_value(),
+        base_url=base_url,
+        model=model,
+        request_timeout_seconds=settings.llm_request_timeout_seconds,
+        max_output_tokens=settings.llm_max_output_tokens,
+        extra_body={"thinking": {"type": "disabled"}},
+    )
+
+
+def build_default_catalog(
+    settings: Settings,
+    *,
+    provider: LLMProvider | None = None,
+) -> DefaultCatalogBuild:
+    """Resolve the baseline provider configuration and expose it as a catalog.
+
+    Exactly the entries that can execute right now are selectable, so the mock
+    modes expose the mock provider and a real deployment exposes the one
+    configured provider -- credentials and base URLs stay in the backend.
+    """
+    scenario_controller: ScenarioController | None = None
+    if provider is None:
+        if settings.enable_mock_llm:
+            if settings.e2e_test_mode:
+                scenario_controller = ScenarioController()
+                provider = ScenarioMockLLMProvider(
+                    controller=scenario_controller,
+                    timeout_delay=settings.generator_timeout_seconds + 0.5,
+                    delays_enabled=settings.mock_delays_enabled,
+                    chunk_size=settings.mock_chunk_size,
+                    generator_delay=settings.mock_generator_delay_seconds,
+                    reviewer_delay=settings.mock_reviewer_delay_seconds,
+                    optimizer_delay=settings.mock_optimizer_delay_seconds,
+                    reviewer_stagger=0.4,
+                )
+            else:
+                provider = MockLLMProvider(
+                    delays_enabled=settings.mock_delays_enabled,
+                    chunk_size=settings.mock_chunk_size,
+                    generator_delay=settings.mock_generator_delay_seconds,
+                    reviewer_delay=settings.mock_reviewer_delay_seconds,
+                    optimizer_delay=settings.mock_optimizer_delay_seconds,
+                )
+        else:
+            provider = _real_provider_from_settings(settings)
+    return DefaultCatalogBuild(
+        catalog=default_catalog(provider, settings),
+        provider=provider,
+        scenario_controller=scenario_controller,
+    )
