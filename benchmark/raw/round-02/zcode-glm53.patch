+/**
+ * The provider catalog as the wire carries it. Anything beyond ids, display
+ * names, and optional capabilities is rejected -- a response carrying pricing
+ * or credentials is a contract violation, not something to silently keep.
+ */
+export function parseProviderCatalogResponse(
+  value: unknown,
+): ProviderCatalogResponse {
+  if (!isRecord(value) || !Array.isArray(value.providers)) {
+    throw new TypeError("Invalid ProviderCatalogResponse contract");
+  }
+  const forbidden = [
+    "api_key",
+    "apiKey",
+    "base_url",
+    "baseUrl",
+    "token",
+    "secret",
+    "price",
+    "pricing",
+  ];
+  for (const provider of value.providers) {
+    if (
+      !isRecord(provider) ||
+      !isString(provider.provider_id) ||
+      provider.provider_id === "" ||
+      !isString(provider.provider_display_name) ||
+      !Array.isArray(provider.models)
+    ) {
+      throw new TypeError("Invalid ProviderCatalogEntry");
+    }
+    const leaking = Object.keys(provider).filter((key) =>
+      forbidden.includes(key),
+    );
+    if (leaking.length > 0) {
+      throw new TypeError(
+        `ProviderCatalogEntry carries backend-only fields: ${leaking.join(", ")}`,
+      );
+    }
+    for (const model of provider.models) {
+      if (
+        !isRecord(model) ||
+        !isString(model.model_id) ||
+        model.model_id === "" ||
+        !isString(model.model_display_name)
+      ) {
+        throw new TypeError("Invalid ModelCatalogEntry");
+      }
+      const modelLeaking = Object.keys(model).filter((key) =>
+        forbidden.includes(key),
+      );
+      if (modelLeaking.length > 0) {
+        throw new TypeError(
+          `ModelCatalogEntry carries backend-only fields: ${modelLeaking.join(", ")}`,
+        );
+      }
+    }
+  }
+  return value as unknown as ProviderCatalogResponse;
+}
+
 export function isRunStatus(value: string): value is RunStatus {
   return RUN_STATUSES.has(value);
 }
