+async def test_selected_runs_keep_pause_resume_cancel_behaviour() -> None:
+    provider = MockLLMProvider(
+        delays_enabled=True,
+        generator_delay=0.001,
+        reviewer_delay=0.03,
+        optimizer_delay=0.001,
