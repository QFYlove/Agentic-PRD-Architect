+++ b/src/hooks/useProviderCatalog.ts
@@ -0,0 +1,68 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+
+import { HttpAgentApi, type AgentApi } from "../lib/api";
+import type { CatalogLoadStatus, ProviderCatalogResponse } from "../lib/types";
+
+export interface UseProviderCatalogOptions {
+  /** Load on mount instead of waiting for the create-run flow to ask for it. */
+  api?: AgentApi;
+}
+
+export interface ProviderCatalogController {
+  status: CatalogLoadStatus;
+  catalog: ProviderCatalogResponse | null;
+  error: string | null;
+  reload(): Promise<void>;
+}
+
+function catalogErrorMessage(): string {
+  // The catalog has exactly one interesting failure -- it could not be read --
+  // and the fix is always the retry button, so no per-code wording is needed.
+  return "无法加载模型列表，请重试。";
+}
+
+/**
+ * Loads the backend-controlled provider/model catalog when the create-run
+ * flow needs it, and keeps the four states a selector has to answer for:
+ * loading, empty, error (with retry), and loaded. The client never invents
+ * entries -- a rejected or failed catalog leaves nothing selectable.
+ */
+export function useProviderCatalog(
+  options: UseProviderCatalogOptions = {},
+): ProviderCatalogController {
+  const api = useMemo(() => options.api ?? new HttpAgentApi(), [options.api]);
+  const [status, setStatus] = useState<CatalogLoadStatus>("loading");
+  const [catalog, setCatalog] = useState<ProviderCatalogResponse | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const mountedRef = useRef(false);
+
+  const reload = useCallback(async (): Promise<void> => {
+    setStatus("loading");
+    setError(null);
+    try {
+      const response = await api.listProviders();
+      if (!mountedRef.current) {
+        return;
+      }
+      setCatalog(response);
+      setStatus(response.providers.length > 0 ? "loaded" : "empty");
+    } catch {
+      if (!mountedRef.current) {
+        return;
+      }
+      setCatalog(null);
+      setError(catalogErrorMessage());
+      setStatus("error");
+    }
+  }, [api]);
+
+  useEffect(() => {
+    mountedRef.current = true;
+    void reload();
+    return () => {
+      mountedRef.current = false;
+    };
+  }, [reload]);
+
+  return { status, catalog, error, reload };
+}
