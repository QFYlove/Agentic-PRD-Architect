+"""Run-level provider/model selection: catalog, create semantics, persistence.
+
+Covers the backend half of the Round 2 contract -- a backend-controlled safe
+catalog, explicit selections that either resolve fully or create nothing, the
+legacy no-field path, snapshot persistence without SQL migrations, concurrent
+run isolation, per-model pricing, and the no-fallback rule for persisted
+selections that the current configuration no longer carries.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import sqlite3
+from decimal import Decimal
+from pathlib import Path
+from typing import Any
+from uuid import UUID
+
+from httpx import ASGITransport, AsyncClient
+
+from backend.config import Settings
+from backend.errors import ProviderSelectionError, ProviderSelectionUnavailableError
+from backend.main import create_app
+from backend.provider_catalog import (
+    CatalogModel,
+    CatalogProvider,
+    ProviderCatalog,
+    ResolvedSelection,
+    RunExecution,
+)
+from backend.providers.mock import MockLLMProvider
+from backend.run_manager import RunManager
+from backend.schemas import CreateRunRequest, RunSnapshot, RunStatus
+from backend.telemetry import ModelPricing, estimate_cost
+from backend.tests.helpers import make_settings, make_sqlite_manager
+from backend.tests.test_workflow import wait_for_status
+
+
+class RecordingProvider(MockLLMProvider):
+    """A mock that remembers which instance served each generation call.
+
+    Different catalog entries hold different instances, so "the run used its
+    own provider object" is directly observable instead of inferred.
+    ``real`` flips ``is_mock`` off for the pricing tests: a mock provider's
+    cost is defined as 0.0, which would hide the per-model rate lookup.
+    """
+
+    def __init__(self, marker: str, *, real: bool = False) -> None:
+        super().__init__(delays_enabled=False)
+        self.marker = marker
+        self.is_mock = not real
+        self.stream_calls: list[str] = []
+
+    async def stream_prd(self, **kwargs: Any) -> Any:  # type: ignore[override]
+        self.stream_calls.append(self.marker)
+        async for event in super().stream_prd(**kwargs):
+            yield event
+
+
+def priced_catalog(*providers: CatalogProvider) -> ProviderCatalog:
+    return ProviderCatalog(providers)
+
+
+def two_provider_catalog(
+    *,
+    a_pricing: ModelPricing | None = None,
+    b_pricing: ModelPricing | None = None,
+    real: bool = False,
+) -> tuple[ProviderCatalog, RecordingProvider, RecordingProvider]:
+    provider_a = RecordingProvider("provider-a-model", real=real)
+    provider_b = RecordingProvider("provider-b-model", real=real)
+    catalog = ProviderCatalog(
+        (
+            CatalogProvider(
+                provider_id="provider-a",
+                provider_display_name="Provider A",
+                models=(
+                    CatalogModel(
+                        model_id="model-a1",
+                        model_display_name="Model A1",
+                        provider=provider_a,
+                        pricing=a_pricing,
+                    ),
+                ),
+            ),
+            CatalogProvider(
+                provider_id="provider-b",
+                provider_display_name="Provider B",
+                models=(
+                    CatalogModel(
+                        model_id="model-b1",
+                        model_display_name="Model B1",
+                        provider=provider_b,
+                        pricing=b_pricing,
+                    ),
+                ),
+            ),
+        )
+    )
+    return catalog, provider_a, provider_b
+
+
+def selection_request(**overrides: Any) -> CreateRunRequest:
+    payload: dict[str, Any] = {
+        "user_idea": "Build a podcast micro-subscription product.",
+        "quality_threshold": 85,
+        "max_iterations": 3,
+        "provider_id": "provider-a",
+        "model_id": "model-a1",
+    }
+    payload.update(overrides)
+    return CreateRunRequest.model_validate(payload)
+
+
+def legacy_request() -> CreateRunRequest:
+    return CreateRunRequest.model_validate(
+        {
+            "user_idea": "Build a legacy default-provider product.",
+            "quality_threshold": 85,
+            "max_iterations": 3,
+        }
+    )
+
+
+async def client_for(app: Any) -> AsyncClient:
+    return AsyncClient(
+        transport=ASGITransport(app=app),  # type: ignore[arg-type]
+        base_url="http://test",
+    )
+
+
+# --- catalog safety ---
+
+
+async def test_catalog_endpoint_returns_safe_shape() -> None:
+    catalog, _, _ = two_provider_catalog(
+        a_pricing=ModelPricing(Decimal("1"), Decimal("2")),
+        b_pricing=ModelPricing(Decimal("3"), Decimal("4")),
+    )
+    app = create_app(
+        settings=make_settings(),
+        provider=MockLLMProvider(delays_enabled=False),
+        catalog=catalog,
+    )
+    async with await client_for(app) as client:
+        response = await client.get("/api/providers")
+
+    assert response.status_code == 200
+    body = response.json()
+    assert [p["provider_id"] for p in body["providers"]] == [
+        "provider-a",
+        "provider-b",
+    ]
+    first = body["providers"][0]
+    assert first["provider_display_name"] == "Provider A"
+    assert first["models"] == [
+        {
+            "model_id": "model-a1",
+            "model_display_name": "Model A1",
+            "capabilities": None,
+        }
+    ]
+
+
+async def test_catalog_never_serializes_credentials_pricing_or_urls() -> None:
+    catalog, _, _ = two_provider_catalog(
+        a_pricing=ModelPricing(Decimal("1.25"), Decimal("5.50"))
+    )
+    app = create_app(
+        settings=make_settings(),
+        provider=MockLLMProvider(delays_enabled=False),
+        catalog=catalog,
+    )
+    async with await client_for(app) as client:
+        body = (await client.get("/api/providers")).json()
+
+    serialized = json.dumps(body)
+    for forbidden in (
+        "api_key",
+        "1.25",
+        "5.50",
+        "base_url",
+        "https://",
+        "token",
+        "secret",
+        "pricing",
+        "price_per_million",
+    ):
+        assert forbidden not in serialized, forbidden
+
+
+async def test_empty_catalog_is_a_valid_empty_response() -> None:
+    app = create_app(
+        settings=make_settings(),
+        provider=MockLLMProvider(delays_enabled=False),
+        catalog=ProviderCatalog(()),
+    )
+    async with await client_for(app) as client:
+        body = (await client.get("/api/providers")).json()
+
+    assert body == {"providers": []}
+
+
+def test_default_mock_catalog_is_deterministic() -> None:
+    settings = make_settings()
+    first = ProviderCatalog(
+        (
+            CatalogProvider(
+                provider_id="mock",
+                provider_display_name="Mock Provider",
+                models=(
+                    CatalogModel(
+                        model_id="mock-prd",
+                        model_display_name="Mock PRD (standard)",
+                        provider=MockLLMProvider(delays_enabled=False),
+                    ),
+                ),
+            ),
+        )
+    )
+    from backend.provider_catalog import default_catalog
+
+    provider = MockLLMProvider(delays_enabled=False)
+    second = default_catalog(provider, settings)
+    assert [p.provider_id for p in first._ordered] == [
+        p.provider_id for p in second._ordered
+    ]
+    assert second._by_id["mock"].models[0].model_id == "mock-prd"
+    assert second._by_id["mock"].models[1].model_id == "mock-prd-lite"
+
+
+# --- explicit selection semantics ---
+
+
+async def test_valid_selection_creates_and_persists_ids_and_names(
+    tmp_path: Path,
+) -> None:
+    database_path = str(tmp_path / "selection.sqlite3")
+    settings = make_settings(database_path=database_path)
+    catalog, provider_a, _ = two_provider_catalog()
+    app = create_app(
+        settings=settings,
+        provider=MockLLMProvider(delays_enabled=False),
+        catalog=catalog,
+    )
+    async with await client_for(app) as client:
+        created = await client.post(
+            "/api/runs",
+            json=selection_request().model_dump(mode="json"),
+        )
+        run_id = UUID(created.json()["run_id"])
+        result = await app.state.manager.wait_for_completion(run_id, wait_seconds=5)
+    await app.state.manager.shutdown()
+
+    assert created.status_code == 202
+    assert result.provider_id == "provider-a"
+    assert result.provider_display_name == "Provider A"
+    assert result.model_id == "model-a1"
+    assert result.model_display_name == "Model A1"
+    # The run's model calls went through its selected provider instance.
+    assert provider_a.stream_calls, "selected provider never served the run"
+
+    # Persisted in the SQLite snapshot itself, readable after a restart.
+    connection = sqlite3.connect(database_path)
+    row = connection.execute(
+        "SELECT snapshot_json FROM runs WHERE run_id = ?", (str(run_id),)
+    ).fetchone()
+    connection.close()
+    stored = json.loads(row[0])
+    assert stored["provider_id"] == "provider-a"
+    assert stored["provider_display_name"] == "Provider A"
+    assert stored["model_id"] == "model-a1"
+    assert stored["model_display_name"] == "Model A1"
+
+
+async def test_unknown_provider_fails_without_creating_a_run() -> None:
+    catalog, _, _ = two_provider_catalog()
+    app = create_app(
+        settings=make_settings(),
+        provider=MockLLMProvider(delays_enabled=False),
+        catalog=catalog,
+    )
+    async with await client_for(app) as client:
+        response = await client.post(
+            "/api/runs",
+            json=selection_request(provider_id="nope").model_dump(mode="json"),
+        )
+        listing = await client.get("/api/runs")
+
+    assert response.status_code == 422
+    assert response.json()["error"]["code"] == "PROVIDER_SELECTION_INVALID"
+    assert listing.json()["total"] == 0
+
+
+async def test_unknown_model_fails_without_creating_a_run() -> None:
+    catalog, _, _ = two_provider_catalog()
