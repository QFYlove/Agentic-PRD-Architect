+import { render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it, vi } from "vitest";
+
+import type { AgentApi } from "../lib/api";
+import { useProviderCatalog } from "../hooks/useProviderCatalog";
+import type { ProviderCatalogResponse } from "../lib/types";
+import { makeCatalog, makeCatalogController } from "../test/fixtures";
+import { ProductIdeaForm } from "./ProductIdeaForm";
+
+const IDEA = "A detailed podcast subscription experience";
+
+function apiWithCatalog(catalog: AgentApi["listProviders"]): AgentApi {
+  return {
+    createRun: vi.fn().mockResolvedValue({
+      run_id: "0c98322f-51a5-47f0-8091-d8152df0e680",
+      status: "QUEUED",
+      events_url: "/api/runs/0c98322f-51a5-47f0-8091-d8152df0e680/events",
+      created_at: "2026-07-26T10:00:00Z",
+    }),
+    listRuns: vi.fn().mockResolvedValue({ items: [], total: 0 }),
+    listProviders: catalog,
+    getRun: vi.fn(),
+    pauseRun: vi.fn(),
+    resumeRun: vi.fn(),
+    cancelRun: vi.fn(),
+    health: vi.fn(),
+    eventsUrl: vi.fn(() => "http://api.test/events"),
+  };
+}
+
+function formFor(
+  catalog: ReturnType<typeof makeCatalogController>,
+  submit = vi.fn().mockResolvedValue(undefined),
+) {
+  render(
+    <ProductIdeaForm
+      isSubmitting={false}
+      catalog={catalog}
+      onSubmit={submit}
+    />,
+  );
+  return submit;
+}
+
+async function fillIdea() {
+  await userEvent.type(screen.getByLabelText(/产品想法/), IDEA);
+}
+
+describe("ProductIdeaForm catalog states", () => {
+  it("keeps the create button disabled while the catalog is loading", () => {
+    formFor(makeCatalogController({ status: "loading", catalog: null }));
+
+    expect(screen.getByTestId("catalog-loading")).toBeTruthy();
+    expect(
+      (
+        screen.getByRole("button", {
+          name: /开始生成 PRD/i,
+        }) as HTMLButtonElement
+      ).disabled,
+    ).toBe(true);
+  });
+
+  it("explains the empty catalog and disables create", () => {
+    formFor(
+      makeCatalogController({ catalog: { providers: [] }, status: "empty" }),
+    );
+
+    expect(screen.getByTestId("catalog-empty")).toBeTruthy();
+    expect(
+      (
+        screen.getByRole("button", {
+          name: /开始生成 PRD/i,
+        }) as HTMLButtonElement
+      ).disabled,
+    ).toBe(true);
+  });
+
+  it("shows the error state and retries loading the catalog", async () => {
+    const reload = vi.fn();
+    formFor(
+      makeCatalogController({
+        status: "error",
+        catalog: null,
+        error: "无法加载模型列表，请重试。",
+        reload,
+      }),
+    );
+
+    expect(screen.getByTestId("catalog-error")).toBeTruthy();
+    expect(
+      (
+        screen.getByRole("button", {
+          name: /开始生成 PRD/i,
+        }) as HTMLButtonElement
+      ).disabled,
+    ).toBe(true);
+    await userEvent.click(screen.getByRole("button", { name: /重试加载/ }));
+    expect(reload).toHaveBeenCalledOnce();
+  });
+
+  it("disables create until a complete provider and model pair is chosen", async () => {
+    const submit = formFor(makeCatalogController());
+    await fillIdea();
+    const button = screen.getByRole("button", {
+      name: /开始生成 PRD/i,
+    }) as HTMLButtonElement;
+
+    expect(button.disabled).toBe(true);
+
+    await userEvent.selectOptions(
+      screen.getByTestId("provider-select"),
+      "provider-a",
+    );
+    expect(button.disabled).toBe(true);
+
+    await userEvent.selectOptions(
+      screen.getByTestId("model-select"),
+      "model-a1",
+    );
+    expect(button.disabled).toBe(false);
+
+    await userEvent.click(button);
+    expect(submit).toHaveBeenCalledOnce();
+    expect(submit).toHaveBeenCalledWith(
+      expect.objectContaining({
+        provider_id: "provider-a",
+        model_id: "model-a1",
+      }),
+    );
+  });
+
+  it("offers only the selected provider's models and resets an incompatible choice", async () => {
+    formFor(makeCatalogController());
+    await fillIdea();
+
+    await userEvent.selectOptions(
+      screen.getByTestId("provider-select"),
+      "provider-a",
+    );
+    const modelSelect = screen.getByTestId("model-select") as HTMLSelectElement;
+    const options = Array.from(modelSelect.options).map((o) => o.value);
+    expect(options).toEqual(["", "model-a1", "model-a2"]);
+
+    await userEvent.selectOptions(modelSelect, "model-a2");
+    await userEvent.selectOptions(
+      screen.getByTestId("provider-select"),
+      "provider-b",
+    );
+    // model-a2 belongs to provider-a; switching providers clears it.
+    const afterSwitch = screen.getByTestId("model-select") as HTMLSelectElement;
+    expect(afterSwitch.value).toBe("");
+    expect(Array.from(afterSwitch.options).map((o) => o.value)).toEqual([
+      "",
+      "model-b1",
+    ]);
+    expect(
+      (
+        screen.getByRole("button", {
+          name: /开始生成 PRD/i,
+        }) as HTMLButtonElement
+      ).disabled,
+    ).toBe(true);
+  });
+
+  it("surfaces a backend selection rejection without substituting another pair", async () => {
+    const submit = vi.fn().mockRejectedValue(
+      Object.assign(new Error("invalid"), {
+        code: "PROVIDER_SELECTION_INVALID",
+      }),
+    );
+    formFor(makeCatalogController(), submit);
+    await fillIdea();
+    await userEvent.selectOptions(
+      screen.getByTestId("provider-select"),
+      "provider-a",
+    );
+    await userEvent.selectOptions(
+      screen.getByTestId("model-select"),
+      "model-a1",
+    );
+    await userEvent.click(
+      screen.getByRole("button", { name: /开始生成 PRD/i }),
+    );
+
+    await waitFor(() => expect(submit).toHaveBeenCalledOnce());
+    // The submitted pair is unchanged; the failure is left for the caller to
+    // render, and the form keeps the user's selection for them to retry.
+    expect(submit).toHaveBeenCalledWith(
+      expect.objectContaining({
+        provider_id: "provider-a",
+        model_id: "model-a1",
+      }),
+    );
+    expect(
+      (screen.getByTestId("provider-select") as HTMLSelectElement).value,
+    ).toBe("provider-a");
+    expect(
+      (screen.getByTestId("model-select") as HTMLSelectElement).value,
+    ).toBe("model-a1");
+  });
+});
+
+describe("useProviderCatalog hook", () => {
+  function Probe({ api }: { api: AgentApi }) {
+    const controller = useProviderCatalog({ api });
+    return (
+      <div>
+        <span data-testid="status">{controller.status}</span>
+        <span data-testid="error">{controller.error ?? "none"}</span>
+        <span data-testid="count">
+          {controller.catalog?.providers.length ?? 0}
+        </span>
+        <button type="button" onClick={() => void controller.reload()}>
+          reload
+        </button>
+      </div>
+    );
+  }
+
+  it("loads, rejects a failing catalog, and recovers on retry", async () => {
+    const listProviders = vi
+      .fn<() => Promise<ProviderCatalogResponse>>()
+      .mockRejectedValueOnce(new Error("down"))
+      .mockResolvedValue(makeCatalog());
+    render(<Probe api={apiWithCatalog(listProviders)} />);
+
+    expect(screen.getByTestId("status").textContent).toBe("loading");
+    await waitFor(() =>
+      expect(screen.getByTestId("status").textContent).toBe("error"),
+    );
+    expect(screen.getByTestId("error").textContent).not.toBe("none");
+
+    await userEvent.click(screen.getByRole("button", { name: /reload/ }));
+    await waitFor(() =>
+      expect(screen.getByTestId("status").textContent).toBe("loaded"),
+    );
+    expect(screen.getByTestId("count").textContent).toBe("2");
+  });
+
+  it("reports an empty catalog as empty rather than error", async () => {
+    render(
+      <Probe
+        api={apiWithCatalog(vi.fn().mockResolvedValue({ providers: [] }))}
+      />,
+    );
+    await waitFor(() =>
+      expect(screen.getByTestId("status").textContent).toBe("empty"),
+    );
+    expect(screen.getByTestId("count").textContent).toBe("0");
+  });
+});
