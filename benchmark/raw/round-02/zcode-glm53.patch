+    render(
+      <AgentDashboard
+        api={apiForSnapshot(
+          makeSnapshot({
+            status: "COMPLETED",
+            provider_id: null,
+            provider_display_name: null,
+            model_id: null,
+            model_display_name: null,
+          }),
+        )}
+        eventSourceFactory={eventSourceFactory}
+      />,
+    );
+
+    expect(
+      (await screen.findByTestId("run-model-selection")).textContent,
+    ).toContain("未知（历史任务）");
+  });
+
+  it("renders a snapshot whose selection keys are missing entirely", async () => {
+    window.history.replaceState({}, "", `/?run_id=${makeSnapshot().run_id}`);
+    const snapshot = makeSnapshot({ status: "COMPLETED" });
+    const legacy = JSON.parse(JSON.stringify(snapshot)) as Record<
+      string,
+      unknown
+    >;
+    delete legacy.provider_id;
+    delete legacy.provider_display_name;
+    delete legacy.model_id;
+    delete legacy.model_display_name;
+    render(
