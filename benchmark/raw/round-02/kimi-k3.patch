+async def test_concurrent_runs_with_different_selections_stay_isolated() -> None:
+    catalog = ModelCatalog(
+        (
+            CatalogProvider(
+                provider_id="mock-a",
+                display_name="Mock A",
+                kind="mock",
+                models=(CatalogModel(model_id="model-a1", display_name="A1"),),
+            ),
+            CatalogProvider(
+                provider_id="mock-b",
+                display_name="Mock B",
+                kind="mock",
+                models=(CatalogModel(model_id="model-b1", display_name="B1"),),
+            ),
+            CatalogProvider(
+                provider_id="mock-c",
+                display_name="Mock C",
+                kind="mock",
+                models=(CatalogModel(model_id="model-c1", display_name="C1"),),
+            ),
+        ),
+        default=("mock-c", "model-c1"),
+    )
+    calls_a: list[str] = []
+    calls_b: list[str] = []
+    built: list[str] = []
+
+    def factory(selection: ResolvedModelSelection) -> TaggingMockProvider:
+        built.append(selection.model_id)
+        if selection.provider_id == "mock-a":
+            return TaggingMockProvider(tag="model-a1", calls=calls_a)
+        return TaggingMockProvider(tag="model-b1", calls=calls_b)
+
+    default_calls: list[str] = []
+    manager = make_sqlite_manager(  # in-memory via :memory: path is fine here
+        database_path=":memory:",
+        provider=TaggingMockProvider(tag="default", calls=default_calls),
+        catalog=catalog,
+        provider_factory=factory,
+    )
+    run_a, run_b = await asyncio.gather(
+        manager.create_run(
+            CreateRunRequest(
+                user_idea=IDEA,
+                provider_id="mock-a",
+                model_id="model-a1",
+            )
+        ),
+        manager.create_run(
+            CreateRunRequest(
+                user_idea=IDEA,
+                provider_id="mock-b",
+                model_id="model-b1",
+            )
+        ),
+    )
+    result_a, result_b = await asyncio.gather(
+        manager.wait_for_completion(run_a.run_id, wait_seconds=5),
+        manager.wait_for_completion(run_b.run_id, wait_seconds=5),
+    )
+
+    assert result_a.status is RunStatus.COMPLETED
+    assert result_b.status is RunStatus.COMPLETED
+    assert (result_a.provider_id, result_a.model_id) == ("mock-a", "model-a1")
+    assert (result_b.provider_id, result_b.model_id) == ("mock-b", "model-b1")
+    assert result_a.provider_display_name == "Mock A"
+    assert result_b.provider_display_name == "Mock B"
+    # Each run's model calls went only to its own bound provider instance.
+    assert calls_a and set(calls_a) == {"model-a1"}
+    assert calls_b and set(calls_b) == {"model-b1"}
+    assert default_calls == []
+    assert set(built) == {"model-a1", "model-b1"}  # neither used the default pair
+
