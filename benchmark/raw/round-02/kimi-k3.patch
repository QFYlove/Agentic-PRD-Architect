+        user_idea=IDEA,
+        status=RunStatus.COMPLETED,
+    )
+    assert legacy.provider_id is None
+    await manager.run_store.create(legacy)
+
+    provider = await manager.provider_for(legacy.run_id)
+
+    assert provider is manager.provider
+    pricing = manager.pricing_for(legacy.run_id, legacy)
+    assert pricing is None  # no prices configured in test settings
