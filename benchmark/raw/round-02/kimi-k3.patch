index 0000000..b396539
--- /dev/null
+++ b/backend/model_catalog.py
@@ -0,0 +1,290 @@
+from __future__ import annotations
+
+from decimal import Decimal
+from typing import Any, Literal
+
+from pydantic import BaseModel, ConfigDict, Field, SecretStr
+
+from backend.config import Settings
+from backend.errors import (
+    AppError,
+    CatalogUnavailableError,
+    ProviderUnavailableError,
+    UnknownModelError,
+    UnknownProviderError,
+)
+from backend.providers.base import LLMProvider
+from backend.providers.compatible import OpenAICompatibleLLMProvider
+from backend.providers.mock import MockLLMProvider
+from backend.providers.scenario import ScenarioController, ScenarioMockLLMProvider
+from backend.schemas import CatalogModelInfo, CatalogProviderInfo
+
+MOCK_PROVIDER_ID = "mock"
+MOCK_PROVIDER_DISPLAY_NAME = "Mock LLM (deterministic)"
+MOCK_DEFAULT_MODEL_ID = "mock-prd-v1"
+MOCK_DEFAULT_MODEL_DISPLAY_NAME = "Mock PRD Model v1"
+MOCK_ALT_MODEL_ID = "mock-prd-v2"
+MOCK_ALT_MODEL_DISPLAY_NAME = "Mock PRD Model v2"
+
+
+class ModelPricing(BaseModel):
+    """Backend-only per-model pricing, in USD per million tokens.
+
+    Scoped to one concrete model: it must never be used as a fallback for a
+    different model, and an absent value means "unknown cost", never zero.
+    """
+
+    model_config = ConfigDict(frozen=True)
+
+    input_price_per_million: Decimal = Field(ge=0)
+    output_price_per_million: Decimal = Field(ge=0)
+
+    @classmethod
+    def from_settings(cls, settings: Settings) -> ModelPricing | None:
+        """The legacy global price pair, valid only for the configured model."""
+        if not settings.has_model_pricing:
+            return None
+        assert settings.model_input_price_per_million is not None
+        assert settings.model_output_price_per_million is not None
+        return cls(
+            input_price_per_million=settings.model_input_price_per_million,
+            output_price_per_million=settings.model_output_price_per_million,
+        )
+
+
+class CatalogModel(BaseModel):
+    """One selectable model. ``pricing`` is backend-only and never serialized."""
+
+    model_config = ConfigDict(frozen=True)
+
+    model_id: str
+    display_name: str
+    capabilities: dict[str, Any] | None = None
+    pricing: ModelPricing | None = None
+
+
+class CatalogProvider(BaseModel):
+    """One configured provider, including its backend-only execution config."""
+
+    model_config = ConfigDict(frozen=True)
+
+    provider_id: str
+    display_name: str
+    kind: Literal["mock", "deepseek", "glm"]
+    api_key: SecretStr | None = Field(default=None, repr=False)
+    base_url: str | None = None
+    models: tuple[CatalogModel, ...] = ()
+
+
+class ResolvedModelSelection(BaseModel):
+    """The immutable provider/model pair a run is bound to.
+
+    Carries the backend-only execution config alongside the safe metadata, so
+    the run manager can build a provider without consulting mutable global
+    state. It is never serialized towards the frontend.
+    """
+
+    model_config = ConfigDict(frozen=True, arbitrary_types_allowed=True)
+
+    provider: CatalogProvider
+    model: CatalogModel
+
+    @property
+    def provider_id(self) -> str:
+        return self.provider.provider_id
+
+    @property
+    def provider_display_name(self) -> str:
+        return self.provider.display_name
+
+    @property
+    def model_id(self) -> str:
+        return self.model.model_id
+
+    @property
+    def model_display_name(self) -> str:
+        return self.model.display_name
+
+    @property
+    def pricing(self) -> ModelPricing | None:
+        return self.model.pricing
+
+
+class ModelCatalog:
+    """The backend-controlled registry of selectable providers and models.
+
+    This is the single authority for "which combinations may a new run pick".
+    The safe projection handed to the API contains only ids, display names and
+    safe capability metadata -- never credentials, base URLs or pricing.
+    """
+
+    def __init__(
+        self,
+        providers: tuple[CatalogProvider, ...],
+        *,
+        default: tuple[str, str] | None,
+    ) -> None:
+        self._providers = providers
+        self._default = default
+
+    @classmethod
+    def from_settings(cls, settings: Settings) -> ModelCatalog:
+        try:
+            return cls._build(settings)
+        except AppError:
+            raise
+        except Exception as exc:  # pragma: no cover - defensive
+            raise CatalogUnavailableError from exc
+
+    @classmethod
+    def _build(cls, settings: Settings) -> ModelCatalog:
+        providers: list[CatalogProvider] = []
+        default: tuple[str, str] | None = None
+        if settings.enable_mock_llm:
+            providers.append(
+                CatalogProvider(
+                    provider_id=MOCK_PROVIDER_ID,
+                    display_name=MOCK_PROVIDER_DISPLAY_NAME,
+                    kind="mock",
+                    models=(
+                        CatalogModel(
+                            model_id=MOCK_DEFAULT_MODEL_ID,
+                            display_name=MOCK_DEFAULT_MODEL_DISPLAY_NAME,
+                        ),
+                        CatalogModel(
+                            model_id=MOCK_ALT_MODEL_ID,
+                            display_name=MOCK_ALT_MODEL_DISPLAY_NAME,
+                        ),
+                    ),
+                )
+            )
+            default = (MOCK_PROVIDER_ID, MOCK_DEFAULT_MODEL_ID)
+        else:
+            legacy_pricing = ModelPricing.from_settings(settings)
+            configured: list[tuple[str, str, str, SecretStr | None, str, str]] = [
+                (
+                    "deepseek",
+                    "DeepSeek",
+                    settings.deepseek_base_url,
+                    settings.deepseek_api_key,
+                    settings.deepseek_model,
+                    settings.deepseek_model,
+                ),
+                (
+                    "glm",
+                    "GLM",
+                    settings.glm_base_url,
+                    settings.glm_api_key,
+                    settings.glm_model,
+                    settings.glm_model,
+                ),
+            ]
+            for kind, display, base_url, api_key, model_id, model_name in configured:
+                if api_key is None:
+                    # Without credentials the provider cannot serve new runs, so
+                    # it is not a selectable catalog entry at all.
+                    continue
+                is_default = settings.llm_provider == kind
+                providers.append(
+                    CatalogProvider(
+                        provider_id=kind,
+                        display_name=display,
+                        kind=kind,
+                        api_key=api_key,
+                        base_url=base_url,
+                        models=(
+                            CatalogModel(
+                                model_id=model_id,
+                                display_name=model_name,
+                                # The legacy global price pair was configured for
+                                # the active model only; applying it to another
+                                # provider's model would be a cross-model fallback.
+                                pricing=legacy_pricing if is_default else None,
+                            ),
+                        ),
+                    )
+                )
+                if is_default:
+                    default = (kind, model_id)
+        return cls(tuple(providers), default=default)
+
+    @property
+    def providers(self) -> tuple[CatalogProvider, ...]:
+        return self._providers
+
+    def resolve(self, provider_id: str, model_id: str) -> ResolvedModelSelection:
+        """Resolve an explicit selection, or fail loudly -- never substitute."""
+        for provider in self._providers:
+            if provider.provider_id != provider_id:
+                continue
+            for model in provider.models:
+                if model.model_id == model_id:
+                    return ResolvedModelSelection(provider=provider, model=model)
+            raise UnknownModelError(provider_id=provider_id, model_id=model_id)
+        raise UnknownProviderError(provider_id=provider_id)
+
+    def default_selection(self) -> ResolvedModelSelection:
+        """The legacy default pair, resolved through the same catalog rules."""
+        if self._default is None:
+            raise ProviderUnavailableError
+        return self.resolve(*self._default)
+
+    def is_default(self, selection: ResolvedModelSelection) -> bool:
+        return self._default == (selection.provider_id, selection.model_id)
+
+    def safe_response_providers(self) -> list[CatalogProviderInfo]:
+        """The only projection that may leave the backend."""
+        return [
+            CatalogProviderInfo(
+                provider_id=provider.provider_id,
+                provider_display_name=provider.display_name,
+                models=[
+                    CatalogModelInfo(
+                        model_id=model.model_id,
+                        model_display_name=model.display_name,
+                        capabilities=model.capabilities,
+                    )
+                    for model in provider.models
+                ],
+            )
+            for provider in self._providers
+        ]
+
+    def create_provider(
+        self,
+        selection: ResolvedModelSelection,
+        settings: Settings,
+        *,
+        scenario_controller: ScenarioController | None = None,
+    ) -> LLMProvider:
+        provider = selection.provider
+        if provider.kind == "mock":
+            if scenario_controller is not None:
+                return ScenarioMockLLMProvider(
+                    controller=scenario_controller,
+                    timeout_delay=settings.generator_timeout_seconds + 0.5,
+                    delays_enabled=settings.mock_delays_enabled,
+                    chunk_size=settings.mock_chunk_size,
+                    generator_delay=settings.mock_generator_delay_seconds,
+                    reviewer_delay=settings.mock_reviewer_delay_seconds,
+                    optimizer_delay=settings.mock_optimizer_delay_seconds,
+                    reviewer_stagger=0.4,
+                )
+            return MockLLMProvider(
+                delays_enabled=settings.mock_delays_enabled,
+                chunk_size=settings.mock_chunk_size,
+                generator_delay=settings.mock_generator_delay_seconds,
+                reviewer_delay=settings.mock_reviewer_delay_seconds,
+                optimizer_delay=settings.mock_optimizer_delay_seconds,
+            )
+        if provider.api_key is None or not provider.base_url:
+            raise ProviderUnavailableError
+        return OpenAICompatibleLLMProvider(
+            provider_name=provider.kind,
+            api_key=provider.api_key.get_secret_value(),
+            base_url=provider.base_url,
+            model=selection.model_id,
+            request_timeout_seconds=settings.llm_request_timeout_seconds,
+            max_output_tokens=settings.llm_max_output_tokens,
+            extra_body={"thinking": {"type": "disabled"}},
+        )
