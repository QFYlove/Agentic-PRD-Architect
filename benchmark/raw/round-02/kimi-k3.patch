@@ -0,0 +1,199 @@
+from __future__ import annotations
+
+import json
+from decimal import Decimal
+from typing import Any
+
+import pytest
+from pydantic import SecretStr
+
+from backend.config import Settings
+from backend.errors import (
+    ProviderUnavailableError,
+    UnknownModelError,
+    UnknownProviderError,
+)
+from backend.model_catalog import (
+    MOCK_ALT_MODEL_ID,
+    MOCK_DEFAULT_MODEL_ID,
+    MOCK_PROVIDER_ID,
+    CatalogModel,
+    CatalogProvider,
+    ModelCatalog,
+    ModelPricing,
+)
+from backend.providers.compatible import OpenAICompatibleLLMProvider
+from backend.providers.mock import MockLLMProvider
+from backend.tests.helpers import make_settings
+
+
+def real_settings(**overrides: Any) -> Settings:
+    return make_settings(
+        enable_mock_llm=False,
+        deepseek_api_key=SecretStr("sk-deepseek-secret"),
+        glm_api_key=SecretStr("glm-secret"),
+        **overrides,
+    )
+
+
+def test_mock_mode_catalog_has_deterministic_mock_entries() -> None:
+    catalog = ModelCatalog.from_settings(make_settings())
+    again = ModelCatalog.from_settings(make_settings())
+
+    assert [p.provider_id for p in catalog.providers] == [MOCK_PROVIDER_ID]
+    assert [m.model_id for m in catalog.providers[0].models] == [
+        MOCK_DEFAULT_MODEL_ID,
+        MOCK_ALT_MODEL_ID,
+    ]
+    assert [p.provider_id for p in again.providers] == [MOCK_PROVIDER_ID]
+    default = catalog.default_selection()
+    assert (default.provider_id, default.model_id) == (
+        MOCK_PROVIDER_ID,
+        MOCK_DEFAULT_MODEL_ID,
+    )
+
+
+def test_real_mode_catalog_covers_only_credentialled_providers() -> None:
+    settings = real_settings()
+    catalog = ModelCatalog.from_settings(settings)
+
+    assert [p.provider_id for p in catalog.providers] == ["deepseek", "glm"]
+    default = catalog.default_selection()
+    assert (default.provider_id, default.model_id) == (
+        "deepseek",
+        settings.deepseek_model,
+    )
+
+    glm_only = make_settings(
+        enable_mock_llm=False,
+        llm_provider="glm",
+        glm_api_key=SecretStr("glm-secret"),
+    )
+    glm_catalog = ModelCatalog.from_settings(glm_only)
+    assert [p.provider_id for p in glm_catalog.providers] == ["glm"]
+    assert (glm_catalog.default_selection().provider_id) == "glm"
+
+
+def test_safe_projection_never_carries_secrets_urls_or_pricing() -> None:
+    settings = real_settings(
+        model_input_price_per_million=Decimal("2"),
+        model_output_price_per_million=Decimal("8"),
+    )
+    catalog = ModelCatalog.from_settings(settings)
+
+    safe = catalog.safe_response_providers()
+    payload = json.dumps([entry.model_dump(mode="json") for entry in safe])
+
+    assert "sk-deepseek-secret" not in payload
+    assert "glm-secret" not in payload
+    assert "api.deepseek.com" not in payload
+    assert "bigmodel.cn" not in payload
+    assert "price" not in payload
+    assert "pricing" not in payload
+    for provider in safe:
+        assert set(provider.model_dump(mode="json")) == {
+            "provider_id",
+            "provider_display_name",
+            "models",
+        }
+        for model in provider.models:
+            assert set(model.model_dump(mode="json")) == {
+                "model_id",
+                "model_display_name",
+                "capabilities",
+            }
+    # The internal registry entry still holds the backend-only config.
+    deepseek = catalog.providers[0]
+    assert deepseek.api_key is not None
+    assert deepseek.base_url == "https://api.deepseek.com"
+    assert deepseek.models[0].pricing is not None
+
+
+def test_legacy_pricing_applies_only_to_the_configured_default_model() -> None:
+    settings = real_settings(
+        model_input_price_per_million=Decimal("2"),
+        model_output_price_per_million=Decimal("8"),
+    )
+    catalog = ModelCatalog.from_settings(settings)
+
+    deepseek = catalog.resolve("deepseek", settings.deepseek_model)
+    glm = catalog.resolve("glm", settings.glm_model)
+    assert deepseek.pricing == ModelPricing(
+        input_price_per_million=Decimal("2"),
+        output_price_per_million=Decimal("8"),
+    )
+    # Never borrowed across models: the other model's cost stays unknown.
+    assert glm.pricing is None
+
+
+def test_explicit_zero_pricing_is_preserved() -> None:
+    pricing = ModelPricing(
+        input_price_per_million=Decimal("0"),
+        output_price_per_million=Decimal("0"),
+    )
+    assert pricing.input_price_per_million == 0
+    assert ModelPricing.from_settings(make_settings()) is None
+
+
+def test_resolve_rejects_unknown_provider_model_and_cross_pair() -> None:
+    settings = real_settings()
+    catalog = ModelCatalog.from_settings(settings)
+
+    with pytest.raises(UnknownProviderError) as provider_error:
+        catalog.resolve("anthropic", "claude")
+    assert provider_error.value.code == "UNKNOWN_PROVIDER"
+    assert provider_error.value.status_code == 400
+
+    with pytest.raises(UnknownModelError) as model_error:
+        catalog.resolve("deepseek", "gpt-4o")
+    assert model_error.value.code == "UNKNOWN_MODEL"
+
+    # The model exists -- under the other provider. Still a hard failure.
+    with pytest.raises(UnknownModelError):
+        catalog.resolve("deepseek", settings.glm_model)
+    with pytest.raises(UnknownModelError):
+        catalog.resolve("glm", settings.deepseek_model)
+
+
+def test_unresolvable_legacy_default_fails_loudly() -> None:
+    catalog = ModelCatalog((), default=None)
+
+    assert catalog.safe_response_providers() == []
+    with pytest.raises(ProviderUnavailableError):
+        catalog.default_selection()
+
+
+def test_create_provider_builds_mock_and_compatible_instances() -> None:
+    settings = real_settings()
+    catalog = ModelCatalog.from_settings(settings)
+
+    mock_catalog = ModelCatalog.from_settings(make_settings())
+    mock_selection = mock_catalog.default_selection()
+    assert isinstance(
+        mock_catalog.create_provider(mock_selection, make_settings()),
+        MockLLMProvider,
+    )
+
+    selection = catalog.resolve("deepseek", settings.deepseek_model)
+    provider = catalog.create_provider(selection, settings)
+    assert isinstance(provider, OpenAICompatibleLLMProvider)
+
+
+def test_disabled_or_empty_catalog_entries_are_not_selectable() -> None:
+    catalog = ModelCatalog(
+        (
+            CatalogProvider(
+                provider_id="empty",
+                display_name="Empty",
+                kind="mock",
+                models=(),
+            ),
+        ),
+        default=None,
+    )
+    with pytest.raises(UnknownModelError):
+        catalog.resolve("empty", "anything")
+
+    model = CatalogModel(model_id="m1", display_name="M1")
+    assert model.capabilities is None
+    assert model.pricing is None
