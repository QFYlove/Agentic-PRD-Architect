+export function parseProvidersCatalog(value: unknown): ProvidersCatalog {
+  if (!isRecord(value) || !Array.isArray(value.providers)) {
+    throw new TypeError("Invalid ProvidersCatalog contract");
+  }
+  for (const provider of value.providers) {
+    if (
+      !isRecord(provider) ||
+      !isString(provider.provider_id) ||
+      !isString(provider.provider_display_name) ||
+      !Array.isArray(provider.models)
+    ) {
+      throw new TypeError("Invalid ProvidersCatalog contract");
+    }
+    for (const model of provider.models) {
+      if (
+        !isRecord(model) ||
+        !isString(model.model_id) ||
+        !isString(model.model_display_name) ||
+        (model.capabilities !== null &&
+          model.capabilities !== undefined &&
+          !isRecord(model.capabilities))
+      ) {
+        throw new TypeError("Invalid ProvidersCatalog contract");
+      }
+    }
+  }
+  return value as unknown as ProvidersCatalog;
+}
