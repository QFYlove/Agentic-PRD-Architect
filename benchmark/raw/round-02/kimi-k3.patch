+async def test_persisted_selection_unavailable_fails_without_fallback(
+    tmp_path: Path,
+) -> None:
+    database = str(tmp_path / "rehydrate.sqlite3")
+    catalog_with_extra = ModelCatalog(
+        (
+            CatalogProvider(
+                provider_id=MOCK_PROVIDER_ID,
+                display_name="Mock",
+                kind="mock",
+                models=(
+                    CatalogModel(model_id=MOCK_DEFAULT_MODEL_ID, display_name="M1"),
+                ),
+            ),
+            CatalogProvider(
+                provider_id="retired",
+                display_name="Retired Provider",
+                kind="mock",
+                models=(CatalogModel(model_id="retired-model", display_name="RM"),),
+            ),
+        ),
+        default=(MOCK_PROVIDER_ID, MOCK_DEFAULT_MODEL_ID),
+    )
+    manager = make_sqlite_manager(
+        database_path=database,
+        catalog=catalog_with_extra,
+        provider_factory=lambda selection: MockLLMProvider(delays_enabled=False),
+    )
+    created = await manager.create_run(
+        CreateRunRequest(
+            user_idea=IDEA,
+            provider_id="retired",
+            model_id="retired-model",
+        )
+    )
+    await manager.wait_for_completion(created.run_id, wait_seconds=5)
+    await manager.shutdown()
+
+    # The provider is gone from the backend configuration after the restart.
+    reopened = make_sqlite_manager(database_path=database)
+    restored = await reopened.get_run(created.run_id)
+    with pytest.raises(PersistedSelectionUnavailableError) as excinfo:
+        await reopened.provider_for(created.run_id)
+    await reopened.shutdown()
+
+    assert excinfo.value.code == "PROVIDER_SELECTION_UNAVAILABLE"
+    # History stays readable: ids and display names are preserved, not rewritten.
+    assert restored.provider_id == "retired"
+    assert restored.provider_display_name == "Retired Provider"
+    assert restored.model_id == "retired-model"
+    assert restored.model_display_name == "RM"
+
