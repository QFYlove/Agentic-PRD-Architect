+import { render, screen, waitFor, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import type { ProviderCatalogState } from "../hooks/useProviderCatalog";
+import { ApiClientError, type AgentApi } from "../lib/api";
+import {
+  makeCatalogProvider,
+  makeProvidersCatalog,
+  makeSnapshot,
+} from "../test/fixtures";
+import { AgentDashboard } from "./AgentDashboard";
+import { ProductIdeaForm } from "./ProductIdeaForm";
+import { TelemetryPanel } from "./TelemetryPanel";
+
+vi.mock("mermaid", () => ({
+  default: {
+    initialize: vi.fn(),
+    render: vi.fn().mockResolvedValue({ svg: "<svg><title>W</title></svg>" }),
+  },
+}));
+
+const MOCK_CATALOG: ProviderCatalogState = {
+  status: "loaded",
+  providers: makeProvidersCatalog().providers,
+};
+
+const TWO_PROVIDER_CATALOG: ProviderCatalogState = {
+  status: "loaded",
+  providers: [
+    ...makeProvidersCatalog().providers,
+    makeCatalogProvider(
+      "alt",
+      [["alt-prd-v1", "Alt PRD Model v1"]],
+      "Alt LLM (second provider)",
+    ),
+  ],
+};
+
+function renderForm(
+  catalog: ProviderCatalogState,
+  submit = vi.fn().mockResolvedValue(undefined),
+) {
+  const retry = vi.fn();
+  render(
+    <ProductIdeaForm
+      isSubmitting={false}
+      catalog={catalog}
+      onRetryCatalog={retry}
+      onSubmit={submit}
+    />,
+  );
+  return { submit, retry };
+}
+
+function providerSelect(): HTMLSelectElement {
+  return screen.getByTestId("provider-select") as HTMLSelectElement;
+}
+
+function modelSelect(): HTMLSelectElement {
+  return screen.getByTestId("model-select") as HTMLSelectElement;
+}
+
+function createButton(): HTMLButtonElement {
+  return screen.getByRole("button", { name: /开始生成 PRD/i });
+}
+
+async function typeIdea() {
+  await userEvent.type(
+    screen.getByLabelText(/产品想法/),
+    "A detailed podcast subscription experience",
+  );
+}
+
+describe("ProductIdeaForm catalog states", () => {
+  it("disables the selectors and Create while the catalog loads", () => {
+    renderForm({ status: "loading" });
+
+    expect(providerSelect().disabled).toBe(true);
+    expect(modelSelect().disabled).toBe(true);
+    expect(createButton().disabled).toBe(true);
+    expect(screen.getByTestId("catalog-status").textContent).toContain(
+      "正在加载",
+    );
+  });
+
+  it("explains an empty catalog and keeps Create disabled", () => {
+    renderForm({ status: "empty" });
+
+    expect(screen.getByTestId("catalog-status").textContent).toContain(
+      "当前没有可用的模型服务与模型",
+    );
+    expect(providerSelect().disabled).toBe(true);
+    expect(createButton().disabled).toBe(true);
+  });
+
+  it("shows the failure with a retry button and keeps Create disabled", async () => {
+    const { retry } = renderForm({
+      status: "error",
+      message: "模型目录暂时不可用，请稍后重试。",
+    });
+
+    const status = screen.getByTestId("catalog-status");
+    expect(status.textContent).toContain("模型目录加载失败");
+    expect(status.textContent).toContain("模型目录暂时不可用");
+    expect(createButton().disabled).toBe(true);
+
+    await userEvent.click(within(status).getByRole("button", { name: /重试/ }));
+    expect(retry).toHaveBeenCalledOnce();
+  });
+
+  it("pre-selects the first provider and its first model once loaded", () => {
+    renderForm(MOCK_CATALOG);
+
+    expect(providerSelect().value).toBe("mock");
+    expect(modelSelect().value).toBe("mock-prd-v1");
+    expect(createButton().disabled).toBe(false);
+  });
+
+  it("lists only the selected provider's models", () => {
+    renderForm(TWO_PROVIDER_CATALOG);
+
+    const modelOptions = within(modelSelect())
+      .getAllByRole("option")
+      .map((option) => option.textContent);
+    expect(modelOptions).toEqual(["Mock PRD Model v1", "Mock PRD Model v2"]);
+
+    const providerOptions = within(providerSelect())
+      .getAllByRole("option")
+      .map((option) => option.textContent);
+    expect(providerOptions).toEqual([
+      "Mock LLM (deterministic)",
+      "Alt LLM (second provider)",
+    ]);
+  });
+
+  it("invalidates an incompatible model when the provider changes", async () => {
+    renderForm(TWO_PROVIDER_CATALOG);
+    await userEvent.selectOptions(modelSelect(), "mock-prd-v2");
+    expect(createButton().disabled).toBe(false);
+
+    await userEvent.selectOptions(providerSelect(), "alt");
+    expect(providerSelect().value).toBe("alt");
+    // The old model does not belong to the new provider: cleared, and Create
+    // stays disabled until the user deliberately re-picks one.
+    expect(modelSelect().value).toBe("");
+    expect(createButton().disabled).toBe(true);
+    const modelOptions = within(modelSelect())
+      .getAllByRole("option")
+      .map((option) => option.textContent);
+    expect(modelOptions).toEqual(["请选择模型", "Alt PRD Model v1"]);
+
+    await userEvent.selectOptions(modelSelect(), "alt-prd-v1");
+    expect(createButton().disabled).toBe(false);
+  });
+
+  it("submits the provider and model ids together", async () => {
+    const { submit } = renderForm(MOCK_CATALOG);
+    await typeIdea();
+    await userEvent.selectOptions(modelSelect(), "mock-prd-v2");
+    await userEvent.click(createButton());
+
+    expect(submit).toHaveBeenCalledOnce();
+    expect(submit).toHaveBeenCalledWith(
+      expect.objectContaining({
+        provider_id: "mock",
+        model_id: "mock-prd-v2",
+      }),
+    );
+  });
+});
+
+describe("ProductIdeaForm backend selection rejection", () => {
+  afterEach(() => {
+    window.history.replaceState({}, "", "/");
+  });
+
+  function rejectingApi(): AgentApi {
+    return {
+      createRun: vi
+        .fn()
+        .mockRejectedValue(
+          new ApiClientError("unknown model", "UNKNOWN_MODEL", 400),
+        ),
+      listRuns: vi.fn().mockResolvedValue({ items: [], total: 0 }),
+      getRun: vi.fn(),
+      getProviders: vi.fn().mockResolvedValue(makeProvidersCatalog()),
+      pauseRun: vi.fn(),
+      resumeRun: vi.fn(),
+      cancelRun: vi.fn(),
+      health: vi.fn(),
+      eventsUrl: () => "http://api.test/events",
+    };
+  }
+
+  function silentEventSource() {
+    return {
+      addEventListener: vi.fn(),
+      close: vi.fn(),
+      readyState: 0,
+      onopen: null,
+      onerror: null,
+    };
+  }
+
+  it("shows the backend's rejection and keeps the user's selection", async () => {
+    render(
+      <AgentDashboard
+        api={rejectingApi()}
+        eventSourceFactory={silentEventSource}
+      />,
+    );
+    await waitFor(() => expect(providerSelect().disabled).toBe(false));
+
+    await typeIdea();
+    await userEvent.selectOptions(modelSelect(), "mock-prd-v2");
+    await userEvent.click(createButton());
+
+    // The error banner carries the localized UNKNOWN_MODEL message...
+    const banner = await screen.findByRole("alert");
+    expect(banner.textContent).toContain(
+      "所选的模型不存在或不属于当前 Provider",
+    );
+    // ...and the form neither fabricated a fallback nor reset the picks.
+    expect(providerSelect().value).toBe("mock");
+    expect(modelSelect().value).toBe("mock-prd-v2");
+    expect(createButton().disabled).toBe(false);
+  });
+});
+
+describe("TelemetryPanel model metadata", () => {
+  it("shows the persisted provider and model display names", () => {
+    render(
+      <TelemetryPanel
+        snapshot={makeSnapshot({
+          provider_id: "mock",
+          provider_display_name: "Mock LLM (deterministic)",
+          model_id: "mock-prd-v2",
+          model_display_name: "Mock PRD Model v2",
+        })}
+      />,
+    );
+
+    expect(screen.getByTestId("telemetry-model").textContent).toBe(
+      "Mock LLM (deterministic) · Mock PRD Model v2",
+    );
+  });
+
+  it.each([
+    ["missing fields", makeSnapshot()],
+    [
+      "null fields",
+      makeSnapshot({
+        provider_id: null,
+        provider_display_name: null,
+        model_id: null,
+        model_display_name: null,
+      }),
+    ],
+  ])("renders a legacy run with %s safely", (_label, snapshot) => {
+    render(<TelemetryPanel snapshot={snapshot} />);
+
+    expect(screen.getByTestId("telemetry-model").textContent).toBe(
+      "未记录（历史任务）",
+    );
+    expect(screen.getByText("1/3")).toBeTruthy();
+  });
+});
