+async def test_cost_uses_the_selected_models_pricing() -> None:
+    settings = make_settings(
+        enable_mock_llm=False,
+        deepseek_api_key=SecretStr("sk-deepseek-secret"),
+        glm_api_key=SecretStr("glm-secret"),
