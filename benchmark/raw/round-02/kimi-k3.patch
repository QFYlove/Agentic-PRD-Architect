+import { act, renderHook, waitFor } from "@testing-library/react";
+import { describe, expect, it, vi } from "vitest";
+
+import { ApiClientError, type AgentApi } from "../lib/api";
+import type { ProvidersCatalog } from "../lib/types";
+import { makeProvidersCatalog } from "../test/fixtures";
+import { useProviderCatalog } from "./useProviderCatalog";
+
+function apiWith(getProviders: AgentApi["getProviders"]): AgentApi {
+  return {
+    createRun: vi.fn(),
+    listRuns: vi.fn(),
+    getRun: vi.fn(),
+    getProviders,
+    pauseRun: vi.fn(),
+    resumeRun: vi.fn(),
+    cancelRun: vi.fn(),
+    health: vi.fn(),
+    eventsUrl: () => "http://api.test/events",
+  };
+}
+
+describe("useProviderCatalog", () => {
+  it("starts loading and resolves to the loaded catalog", async () => {
+    const api = apiWith(vi.fn().mockResolvedValue(makeProvidersCatalog()));
+    const { result } = renderHook(() => useProviderCatalog(api));
+
+    expect(result.current.catalog.status).toBe("loading");
+    await waitFor(() => expect(result.current.catalog.status).toBe("loaded"));
+    const catalog = result.current.catalog;
+    expect(catalog.status === "loaded" && catalog.providers).toHaveLength(1);
+  });
+
+  it("treats an empty catalog as a legal state, not an error", async () => {
+    const api = apiWith(vi.fn().mockResolvedValue({ providers: [] }));
+    const { result } = renderHook(() => useProviderCatalog(api));
+
+    await waitFor(() => expect(result.current.catalog.status).toBe("empty"));
+  });
+
+  it("surfaces a localized error and recovers through retry", async () => {
+    const getProviders = vi
+      .fn()
+      .mockRejectedValueOnce(
+        new ApiClientError("catalog broken", "CATALOG_UNAVAILABLE", 500),
+      )
+      .mockResolvedValueOnce(makeProvidersCatalog());
+    const api = apiWith(getProviders);
+    const { result } = renderHook(() => useProviderCatalog(api));
+
+    await waitFor(() => expect(result.current.catalog.status).toBe("error"));
+    const failed = result.current.catalog;
+    expect(failed.status === "error" && failed.message).toBe(
+      "模型目录暂时不可用，请稍后重试。",
+    );
+
+    act(() => result.current.retry());
+    await waitFor(() => expect(result.current.catalog.status).toBe("loaded"));
+    expect(getProviders).toHaveBeenCalledTimes(2);
+  });
+
+  it("falls back to a generic message for non-API failures", async () => {
+    const api = apiWith(vi.fn().mockRejectedValue(new Error("boom")));
+    const { result } = renderHook(() => useProviderCatalog(api));
+
+    await waitFor(() => expect(result.current.catalog.status).toBe("error"));
+    const failed = result.current.catalog;
+    expect(failed.status === "error" && failed.message).toBe(
+      "模型目录加载失败，请稍后重试。",
+    );
+  });
+
+  it("ignores a response that lands after unmount", async () => {
+    let release: ((catalog: ProvidersCatalog) => void) | null = null;
+    const api = apiWith(
+      vi.fn(
+        () =>
+          new Promise<ProvidersCatalog>((resolve) => {
+            release = resolve;
+          }),
+      ),
+    );
+    const { result, unmount } = renderHook(() => useProviderCatalog(api));
+    expect(result.current.catalog.status).toBe("loading");
+
+    unmount();
+    act(() => release?.(makeProvidersCatalog()));
+    // The late resolution must not resurrect state on an unmounted hook.
+    await waitFor(() => expect(result.current.catalog.status).toBe("loading"));
+  });
+});
