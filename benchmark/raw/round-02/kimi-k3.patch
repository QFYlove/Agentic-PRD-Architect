+async def test_pre_round2_sqlite_row_loads_without_ddl_migration(
+    tmp_path: Path,
+) -> None:
+    """A row written before selection fields existed must load as-is."""
+    database = tmp_path / "legacy.sqlite3"
+    connection = sqlite3.connect(database)
+    connection.execute(
+        """
+        CREATE TABLE runs (
+            run_id TEXT PRIMARY KEY,
+            snapshot_json TEXT NOT NULL,
+            updated_at TEXT NOT NULL
+        )
+        """
+    )
+    fixture = json.loads(
+        (
+            Path(__file__).parents[2] / "contracts" / "v1" / "run_snapshot.json"
+        ).read_text(encoding="utf-8")
+    )
+    assert "provider_id" not in fixture
+    connection.execute(
+        "INSERT INTO runs (run_id, snapshot_json, updated_at) VALUES (?, ?, ?)",
+        (fixture["run_id"], json.dumps(fixture), fixture["updated_at"]),
+    )
+    connection.commit()
+    connection.close()
+
+    store = SQLiteRunStore(
+        database_path=str(database),
+        max_runs=10,
+        ttl_seconds=2_592_000,
+    )
+    restored = await store.get(UUID(fixture["run_id"]))
+
+    # The table kept its original three columns: no migration was performed.
+    columns = {row[1] for row in store._connection.execute("PRAGMA table_info(runs)")}
+    await store.close()
+
+    assert columns == {"run_id", "snapshot_json", "updated_at"}
+    assert restored.provider_id is None
+    assert restored.provider_display_name is None
+    assert restored.model_id is None
+    assert restored.model_display_name is None
