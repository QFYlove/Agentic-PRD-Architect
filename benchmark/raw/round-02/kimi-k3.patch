@@ -0,0 +1,73 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+
+import { ApiClientError, HttpAgentApi, type AgentApi } from "../lib/api";
+import { localizedErrorMessage } from "../lib/errorMessages";
+import type { ProviderCatalogEntry } from "../lib/types";
+
+export type ProviderCatalogState =
+  | { status: "loading" }
+  | { status: "error"; message: string }
+  | { status: "empty" }
+  | { status: "loaded"; providers: ProviderCatalogEntry[] };
+
+export interface ProviderCatalogController {
+  catalog: ProviderCatalogState;
+  retry(): void;
+}
+
+function messageFromError(error: unknown): string {
+  if (error instanceof ApiClientError) {
+    return localizedErrorMessage(error.code);
+  }
+  return "模型目录加载失败，请稍后重试。";
+}
+
+/**
+ * The provider/model catalog the Create Run form selects from.
+ *
+ * The backend owns the catalog; this hook only fetches it and reduces the
+ * result to the four states the form knows how to render. An empty catalog is
+ * a legal answer, not an error.
+ */
+export function useProviderCatalog(api?: AgentApi): ProviderCatalogController {
+  const resolvedApi = useMemo(() => api ?? new HttpAgentApi(), [api]);
+  const [catalog, setCatalog] = useState<ProviderCatalogState>({
+    status: "loading",
+  });
+  const mountedRef = useRef(false);
+  const generationRef = useRef(0);
+
+  const load = useCallback(async (): Promise<void> => {
+    const generation = ++generationRef.current;
+    setCatalog({ status: "loading" });
+    try {
+      const response = await resolvedApi.getProviders();
+      if (!mountedRef.current || generation !== generationRef.current) {
+        return;
+      }
+      setCatalog(
+        response.providers.length === 0
+          ? { status: "empty" }
+          : { status: "loaded", providers: response.providers },
+      );
+    } catch (error) {
+      if (!mountedRef.current || generation !== generationRef.current) {
+        return;
+      }
+      setCatalog({ status: "error", message: messageFromError(error) });
+    }
+  }, [resolvedApi]);
+
+  useEffect(() => {
+    mountedRef.current = true;
+    void load();
+    return () => {
+      mountedRef.current = false;
+    };
+  }, [load]);
+
+  return {
+    catalog,
+    retry: () => void load(),
+  };
+}
