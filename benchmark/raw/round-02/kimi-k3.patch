+    )
+    catalog = ModelCatalog.from_settings(settings)
+    manager = make_sqlite_manager(
+        database_path=":memory:",
+        settings=settings,
+        provider=PricedMockProvider(delays_enabled=False),
+        catalog=catalog,
+        provider_factory=lambda selection: PricedMockProvider(delays_enabled=False),
+    )
+
+    priced = await manager.create_run(
+        CreateRunRequest(
+            user_idea=IDEA,
+            provider_id="deepseek",
+            model_id=settings.deepseek_model,
+        )
+    )
+    priced_result = await manager.wait_for_completion(priced.run_id, wait_seconds=5)
+
+    unpriced = await manager.create_run(
+        CreateRunRequest(
+            user_idea=IDEA,
+            provider_id="glm",
+            model_id=settings.glm_model,
+        )
+    )
+    unpriced_result = await manager.wait_for_completion(
+        unpriced.run_id,
+        wait_seconds=5,
+    )
+
+    deepseek_selection = catalog.resolve("deepseek", settings.deepseek_model)
+    expected = estimate_cost(
+        priced_result.total_tokens,
+        deepseek_selection.pricing,
+        is_mock=False,
+    )
+    assert priced_result.total_tokens.total_tokens > 0
+    assert expected is not None and expected > 0
+    assert priced_result.estimated_cost_usd == expected
+    assert priced_result.cost_available is True
+
+    # The glm model has no configured price: unknown, not zero, never borrowed.
+    assert unpriced_result.total_tokens.total_tokens > 0
+    assert unpriced_result.estimated_cost_usd is None
+    assert unpriced_result.cost_available is False
+
