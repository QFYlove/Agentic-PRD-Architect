@@ -0,0 +1,600 @@
+from __future__ import annotations
+
+import asyncio
+import json
+import sqlite3
+from decimal import Decimal
+from pathlib import Path
+from uuid import UUID
+
+import pytest
+from httpx import ASGITransport, AsyncClient
+from pydantic import SecretStr
+
+from backend.errors import PersistedSelectionUnavailableError
+from backend.language import DEFAULT_OUTPUT_LANGUAGE
+from backend.main import create_app
+from backend.model_catalog import (
+    MOCK_ALT_MODEL_ID,
+    MOCK_DEFAULT_MODEL_ID,
+    MOCK_PROVIDER_ID,
+    CatalogModel,
+    CatalogProvider,
+    ModelCatalog,
+    ResolvedModelSelection,
+)
+from backend.providers.base import ProviderStructuredResult
+from backend.providers.mock import MockLLMProvider
+from backend.run_store import SQLiteRunStore
+from backend.schemas import (
+    CreateRunRequest,
+    ResumeRunRequest,
+    ReviewRole,
+    RunSnapshot,
+    RunStatus,
+)
+from backend.telemetry import estimate_cost
+from backend.tests.helpers import make_settings, make_sqlite_manager
+from backend.tests.test_workflow import wait_for_status
+
+IDEA = "Build a podcast micro-subscription product."
+
+
+def valid_request(**overrides: object) -> dict[str, object]:
+    payload: dict[str, object] = {
+        "user_idea": IDEA,
+        "quality_threshold": 85,
+        "max_iterations": 3,
+    }
+    payload.update(overrides)
+    return payload
+
+
+def explicit_selection(model_id: str = MOCK_DEFAULT_MODEL_ID) -> dict[str, str]:
+    return {"provider_id": MOCK_PROVIDER_ID, "model_id": model_id}
+
+
+async def client_for(app: object) -> AsyncClient:
+    return AsyncClient(
+        transport=ASGITransport(app=app),  # type: ignore[arg-type]
+        base_url="http://test",
+    )
+
+
+def make_mock_app(**settings_overrides: object) -> object:
+    return create_app(
+        settings=make_settings(**settings_overrides),
+        provider=MockLLMProvider(delays_enabled=False),
+    )
+
+
+async def test_providers_catalog_endpoint_shape() -> None:
+    app = make_mock_app()
+    async with await client_for(app) as client:
+        response = await client.get("/api/providers")
+
+    assert response.status_code == 200
+    body = response.json()
+    assert set(body) == {"providers"}
+    assert len(body["providers"]) == 1
+    provider = body["providers"][0]
+    assert set(provider) == {"provider_id", "provider_display_name", "models"}
+    assert provider["provider_id"] == MOCK_PROVIDER_ID
+    assert isinstance(provider["provider_display_name"], str)
+    assert [m["model_id"] for m in provider["models"]] == [
+        MOCK_DEFAULT_MODEL_ID,
+        MOCK_ALT_MODEL_ID,
+    ]
+    for model in provider["models"]:
+        assert set(model) == {"model_id", "model_display_name", "capabilities"}
+
+
+async def test_providers_catalog_never_serializes_secrets_or_pricing() -> None:
+    app = create_app(
+        settings=make_settings(
+            enable_mock_llm=False,
+            deepseek_api_key=SecretStr("sk-deepseek-secret"),
+            glm_api_key=SecretStr("glm-secret"),
+            model_input_price_per_million=Decimal("2"),
+            model_output_price_per_million=Decimal("8"),
+        ),
+        provider=MockLLMProvider(delays_enabled=False),
+    )
+    async with await client_for(app) as client:
+        response = await client.get("/api/providers")
+
+    assert response.status_code == 200
+    raw = response.text
+    assert "sk-deepseek-secret" not in raw
+    assert "glm-secret" not in raw
+    assert "api.deepseek.com" not in raw
+    assert "bigmodel.cn" not in raw
+    assert "price" not in raw
+    assert [p["provider_id"] for p in response.json()["providers"]] == [
+        "deepseek",
+        "glm",
+    ]
+
+
+async def test_providers_catalog_failure_is_an_error_not_a_fake_catalog(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    app = make_mock_app()
+
+    def boom() -> list[object]:
+        raise RuntimeError("catalog store corrupted")
+
+    monkeypatch.setattr(app.state.catalog, "safe_response_providers", boom)  # type: ignore[attr-defined]
+    async with await client_for(app) as client:
+        response = await client.get("/api/providers")
+
+    assert response.status_code == 500
+    assert response.json()["error"]["code"] == "CATALOG_UNAVAILABLE"
+    assert "providers" not in response.json()
+
+
+async def test_explicit_selection_creates_run_and_persists_metadata() -> None:
+    app = make_mock_app()
+    async with await client_for(app) as client:
+        created = await client.post(
+            "/api/runs",
+            json=valid_request(**explicit_selection(MOCK_ALT_MODEL_ID)),
+        )
+        assert created.status_code == 202
+        body = created.json()
+        assert body["provider_id"] == MOCK_PROVIDER_ID
+        assert body["model_id"] == MOCK_ALT_MODEL_ID
+        assert body["provider_display_name"]
+        assert body["model_display_name"]
+
+        run_id = body["run_id"]
+        await app.state.manager.wait_for_completion(UUID(run_id), wait_seconds=5)  # type: ignore[attr-defined]
+        snapshot = (await client.get(f"/api/runs/{run_id}")).json()
+
+    assert snapshot["status"] == "COMPLETED"
+    assert snapshot["provider_id"] == MOCK_PROVIDER_ID
+    assert snapshot["model_id"] == MOCK_ALT_MODEL_ID
+    assert snapshot["provider_display_name"] == body["provider_display_name"]
+    assert snapshot["model_display_name"] == body["model_display_name"]
+
+
+async def test_unknown_provider_fails_without_creating_a_run() -> None:
+    app = make_mock_app()
+    async with await client_for(app) as client:
+        response = await client.post(
+            "/api/runs",
+            json=valid_request(provider_id="anthropic", model_id="claude"),
+        )
+        runs = await client.get("/api/runs")
+
+    assert response.status_code == 400
+    assert response.json()["error"]["code"] == "UNKNOWN_PROVIDER"
+    assert runs.json()["total"] == 0
+
+
+async def test_unknown_model_fails_without_creating_a_run() -> None:
+    app = make_mock_app()
+    async with await client_for(app) as client:
+        response = await client.post(
+            "/api/runs",
+            json=valid_request(provider_id=MOCK_PROVIDER_ID, model_id="gpt-4o"),
+        )
+        runs = await client.get("/api/runs")
+
+    assert response.status_code == 400
+    assert response.json()["error"]["code"] == "UNKNOWN_MODEL"
+    assert runs.json()["total"] == 0
+
+
+async def test_cross_pair_mismatch_fails_without_substitution() -> None:
+    app = create_app(
+        settings=make_settings(
+            enable_mock_llm=False,
+            deepseek_api_key=SecretStr("sk-deepseek-secret"),
+            glm_api_key=SecretStr("glm-secret"),
+        ),
+        provider=MockLLMProvider(delays_enabled=False),
+    )
+    async with await client_for(app) as client:
+        response = await client.post(
