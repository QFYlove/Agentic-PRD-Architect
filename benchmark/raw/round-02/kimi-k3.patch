+class TaggingMockProvider(MockLLMProvider):
+    """A deterministic mock that records which selection's model it served."""
+
+    def __init__(self, *, tag: str, calls: list[str]) -> None:
+        super().__init__(delays_enabled=False)
+        self.tag = tag
+        self.calls = calls
+
+    async def generate_review(
+        self,
+        *,
+        role: ReviewRole,
+        prd: str,
+        iteration: int,
+        output_language: str = DEFAULT_OUTPUT_LANGUAGE,
+    ) -> ProviderStructuredResult:
+        self.calls.append(self.tag)
+        return await super().generate_review(
+            role=role,
+            prd=prd,
+            iteration=iteration,
+            output_language=output_language,
+        )
+
