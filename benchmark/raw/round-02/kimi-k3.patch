diff --git a/e2e/provider-selection.spec.ts b/e2e/provider-selection.spec.ts
new file mode 100644
index 0000000..1fb3057
--- /dev/null
+++ b/e2e/provider-selection.spec.ts
@@ -0,0 +1,198 @@
+import { expect, test, type Page } from "@playwright/test";
+
+import {
+  getSnapshot,
+  PODCAST_IDEA,
+  setScenario,
+  startRun,
+  waitForStatus,
+} from "./helpers";
+
+test.beforeEach(async ({ request }) => {
+  await setScenario(request, "happy");
+});
+
+async function createRunWithModel(
+  page: Page,
+  modelId: string,
+): Promise<string> {
+  await page.goto("/");
+  const modelSelect = page.getByTestId("model-select");
+  // The selectors stay disabled until the catalog has loaded; the enabled
+  // state is the signal that defaults were applied and a pair can be picked.
+  await expect(modelSelect).toBeEnabled();
+  await modelSelect.selectOption(modelId);
+  await page.getByLabel("产品想法").fill(PODCAST_IDEA);
+  await page.getByRole("button", { name: "开始生成 PRD" }).click();
+  await expect
+    .poll(() => new URL(page.url()).searchParams.get("run_id"))
+    .not.toBeNull();
+  return new URL(page.url()).searchParams.get("run_id")!;
+}
+
+test("a picked provider/model pair is persisted and shown in telemetry", async ({
+  page,
+  request,
+}) => {
+  await page.goto("/");
+  const providerSelect = page.getByTestId("provider-select");
+  const modelSelect = page.getByTestId("model-select");
+  await expect(providerSelect).toBeEnabled();
+  // The mock catalog is one provider with two models, first pair pre-selected.
+  await expect(providerSelect).toHaveValue("mock");
+  await expect(modelSelect).toHaveValue("mock-prd-v1");
+
+  await modelSelect.selectOption("mock-prd-v2");
+  await page.getByLabel("产品想法").fill(PODCAST_IDEA);
+  await page.getByRole("button", { name: "开始生成 PRD" }).click();
+  await expect
+    .poll(() => new URL(page.url()).searchParams.get("run_id"))
+    .not.toBeNull();
+  const runId = new URL(page.url()).searchParams.get("run_id")!;
+
+  await waitForStatus(page, "已完成");
+  await page.getByTestId("workspace-tab-trace").click();
+  await expect(page.getByTestId("telemetry-model")).toHaveText(
+    "Mock LLM (deterministic) · Mock PRD Model v2",
+  );
+
+  const snapshot = await getSnapshot(request, runId);
+  expect(snapshot.provider_id).toBe("mock");
+  expect(snapshot.provider_display_name).toBe("Mock LLM (deterministic)");
+  expect(snapshot.model_id).toBe("mock-prd-v2");
+  expect(snapshot.model_display_name).toBe("Mock PRD Model v2");
+});
+
+test("two runs with different models keep their own metadata", async ({
+  page,
+  request,
+}) => {
+  const firstRunId = await createRunWithModel(page, "mock-prd-v1");
+  await waitForStatus(page, "已完成");
+
+  // The 新建对话 flow must still work with the selector in place.
+  await page.getByRole("button", { name: "新建对话" }).click();
+  const modelSelect = page.getByTestId("model-select");
+  await expect(modelSelect).toBeEnabled();
+  await expect(modelSelect).toHaveValue("mock-prd-v1");
+  await modelSelect.selectOption("mock-prd-v2");
+  const secondIdea =
+    "打造一个面向企业知识库团队的订阅产品，支持按文档集合付费。";
+  await page.getByLabel("产品想法").fill(secondIdea);
+  await page.getByRole("button", { name: "开始生成 PRD" }).click();
+  // 新建对话 already cleared the URL identity, so the next non-null run_id
+  // belongs to this run.
+  await expect
+    .poll(() => new URL(page.url()).searchParams.get("run_id"))
+    .not.toBeNull();
+  const secondRunId = new URL(page.url()).searchParams.get("run_id")!;
+  expect(secondRunId).not.toBe(firstRunId);
+  await waitForStatus(page, "已完成");
+
+  const first = await getSnapshot(request, firstRunId);
+  const second = await getSnapshot(request, secondRunId);
+  expect(first.model_id).toBe("mock-prd-v1");
+  expect(first.model_display_name).toBe("Mock PRD Model v1");
+  expect(second.model_id).toBe("mock-prd-v2");
+  expect(second.model_display_name).toBe("Mock PRD Model v2");
+
+  // Telemetry follows whichever run is selected in the sidebar.
+  await page.getByTestId("workspace-tab-trace").click();
+  await expect(page.getByTestId("telemetry-model")).toContainText(
+    "Mock PRD Model v2",
+  );
+  await page
+    .getByRole("button", { name: new RegExp(PODCAST_IDEA) })
+    .first()
+    .click();
+  await expect
+    .poll(() => new URL(page.url()).searchParams.get("run_id"))
+    .toBe(firstRunId);
+  await expect(page.getByTestId("telemetry-model")).toContainText(
+    "Mock PRD Model v1",
+  );
+});
+
+test("an empty catalog disables Create and says so", async ({ page }) => {
+  await page.route("**/api/providers", (route) =>
+    route.fulfill({
+      status: 200,
+      contentType: "application/json",
+      body: JSON.stringify({ providers: [] }),
+    }),
+  );
+  await page.goto("/");
+
+  await expect(page.getByTestId("catalog-status")).toContainText(
+    "当前没有可用的模型服务与模型",
+  );
+  await expect(page.getByTestId("provider-select")).toBeDisabled();
+  await expect(
+    page.getByRole("button", { name: "开始生成 PRD" }),
+  ).toBeDisabled();
+});
+
+test("a failing catalog shows the error, retries, and recovers", async ({
+  page,
+}) => {
+  let catalogCalls = 0;
+  await page.route("**/api/providers", async (route) => {
+    catalogCalls += 1;
+    if (catalogCalls === 1) {
+      await route.fulfill({
+        status: 500,
+        contentType: "application/json",
+        body: JSON.stringify({
+          error: {
+            code: "CATALOG_UNAVAILABLE",
+            message: "Catalog storage is unreadable.",
+            request_id: "e2e-catalog-failure",
+          },
+        }),
+      });
+      return;
+    }
+    await route.continue();
+  });
+  await page.goto("/");
+
+  const status = page.getByTestId("catalog-status");
+  await expect(status).toContainText("模型目录加载失败");
+  await expect(status).toContainText("模型目录暂时不可用");
+  // The raw backend message never reaches the page.
+  await expect(status).not.toContainText("unreadable");
+  await expect(
+    page.getByRole("button", { name: "开始生成 PRD" }),
+  ).toBeDisabled();
+
+  await status.getByRole("button", { name: /重试/ }).click();
+  await expect(page.getByTestId("provider-select")).toBeEnabled();
+  await expect(
+    page.getByRole("button", { name: "开始生成 PRD" }),
+  ).toBeEnabled();
+  expect(catalogCalls).toBe(2);
+});
+
+test("switching between a run and a new conversation stays intact", async ({
+  page,
+}) => {
+  const runId = await startRun(page);
+  await waitForStatus(page, "已完成");
+
+  await page.getByRole("button", { name: "新建对话" }).click();
+  await expect(
+    page.getByRole("heading", { name: /让每一份需求/ }),
+  ).toBeVisible();
+  // A fresh form reloads defaults from the catalog rather than reusing the
+  // previous run's pair silently.
+  await expect(page.getByTestId("model-select")).toHaveValue("mock-prd-v1");
+
+  await page
+    .getByRole("button", { name: new RegExp(PODCAST_IDEA) })
+    .first()
+    .click();
+  await expect
+    .poll(() => new URL(page.url()).searchParams.get("run_id"))
+    .toBe(runId);
+  await waitForStatus(page, "已完成");
+});
