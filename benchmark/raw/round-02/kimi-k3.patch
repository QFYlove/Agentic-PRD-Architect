+async def test_pause_resume_and_cancel_keep_the_bound_selection() -> None:
+    provider = MockLLMProvider(
+        delays_enabled=True,
+        generator_delay=0.001,
+        reviewer_delay=0.03,
+        optimizer_delay=0.001,
+    )
+    manager = make_sqlite_manager(database_path=":memory:", provider=provider)
+    created = await manager.create_run(
+        CreateRunRequest(
+            user_idea="Build a pausable product workflow.",
+            provider_id=MOCK_PROVIDER_ID,
+            model_id=MOCK_ALT_MODEL_ID,
+        )
+    )
+    await wait_for_status(manager, created.run_id, {RunStatus.REVIEWING})
+
+    requested = await manager.request_pause(created.run_id)
+    assert requested.status is RunStatus.PAUSE_REQUESTED
+    await wait_for_status(manager, created.run_id, {RunStatus.PAUSED})
+    await manager.resume_run(
+        created.run_id,
+        ResumeRunRequest(user_override="Add explicit refund reconciliation."),
+    )
+    result = await manager.wait_for_completion(created.run_id, wait_seconds=5)
+
+    assert result.status is RunStatus.COMPLETED
+    assert result.provider_id == MOCK_PROVIDER_ID
+    assert result.model_id == MOCK_ALT_MODEL_ID
+
+    cancellable = await manager.create_run(
+        CreateRunRequest(
+            user_idea="Build a cancellable product workflow.",
+            provider_id=MOCK_PROVIDER_ID,
+            model_id=MOCK_DEFAULT_MODEL_ID,
+        )
+    )
+    cancelled = await manager.cancel_run(cancellable.run_id)
+    final = await manager.wait_for_completion(cancellable.run_id, wait_seconds=5)
+
+    assert cancelled.status is RunStatus.CANCELLED
+    assert final.status is RunStatus.CANCELLED
+    assert final.provider_id == MOCK_PROVIDER_ID
+    assert final.model_id == MOCK_DEFAULT_MODEL_ID
+
+
+async def test_legacy_run_without_selection_uses_baseline_provider() -> None:
