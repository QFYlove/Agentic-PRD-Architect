+        super().__init__(
+            "CATALOG_UNAVAILABLE",
+            "The provider catalog is not available.",
+            500,
+        )
+
+
+class PersistedSelectionUnavailableError(ProviderError):
+    """A run's persisted provider/model pair is no longer configured.
+
+    Raised on execution paths that must rebuild provider access from the stored
+    ids: the historical metadata stays readable, but the run fails rather than
+    silently switching to another provider or model.
+    """
+
+    code = "PROVIDER_SELECTION_UNAVAILABLE"
+    retryable = False
+    user_message = "The provider or model recorded for this run is no longer available."
