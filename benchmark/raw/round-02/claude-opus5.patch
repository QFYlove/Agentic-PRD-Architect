new file mode 100644
index 0000000..0d81bf3
--- /dev/null
+++ b/src/hooks/useProviderCatalog.ts
@@ -0,0 +1,85 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+
+import { ApiClientError, type AgentApi } from "../lib/api";
+import { localizedErrorMessage } from "../lib/errorMessages";
+import type { ProviderOption } from "../lib/types";
+
+/**
+ * Four states, because the form has to behave differently in each one.
+ *
+ * `empty` is deliberately not folded into `loaded`: a backend that answered
+ * correctly with nothing runnable is not an error, but it still cannot accept a
+ * run, and the user needs to be told which of the two happened.
+ */
+export type ProviderCatalogStatus = "loading" | "empty" | "error" | "loaded";
+
+export interface ProviderCatalogState {
+  status: ProviderCatalogStatus;
+  providers: ProviderOption[];
+  /** Localized, user-facing reason for `status === "error"`; otherwise null. */
+  error: string | null;
+  reload(): void;
+}
+
+function messageFromError(error: unknown): string {
+  if (error instanceof ApiClientError) {
+    return localizedErrorMessage(error.code);
+  }
+  return "无法加载可选的 Provider / 模型列表，请稍后重试。";
+}
+
+/**
+ * The backend catalog, and nothing else.
+ *
+ * There is no hard-coded fallback list here on purpose: offering a combination
+ * this backend never advertised would put the user in front of a choice that
+ * can only fail at create time.
+ */
+export function useProviderCatalog(api: AgentApi): ProviderCatalogState {
+  const [status, setStatus] = useState<ProviderCatalogStatus>("loading");
+  const [providers, setProviders] = useState<ProviderOption[]>([]);
+  const [error, setError] = useState<string | null>(null);
+  const mountedRef = useRef(false);
+  const attemptRef = useRef(0);
+
+  const load = useCallback(async (): Promise<void> => {
+    const attempt = ++attemptRef.current;
+    setStatus("loading");
+    setError(null);
+    try {
+      const response = await api.listProviders();
+      if (!mountedRef.current || attempt !== attemptRef.current) {
+        return;
+      }
+      // A provider with no selectable model cannot complete a pair, so it is
+      // dropped rather than shown as a dead end in the selector.
+      const usable = response.providers.filter(
+        (provider) => provider.models.length > 0,
+      );
+      setProviders(usable);
+      setStatus(usable.length === 0 ? "empty" : "loaded");
+    } catch (cause) {
+      if (!mountedRef.current || attempt !== attemptRef.current) {
+        return;
+      }
+      setProviders([]);
+      setError(messageFromError(cause));
+      setStatus("error");
+    }
+  }, [api]);
+
+  useEffect(() => {
+    mountedRef.current = true;
+    void load();
+    return () => {
+      mountedRef.current = false;
+      attemptRef.current += 1;
+    };
+  }, [load]);
+
+  const reload = useCallback(() => {
+    void load();
+  }, [load]);
+
+  return { status, providers, error, reload };
+}
