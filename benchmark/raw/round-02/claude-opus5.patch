+def table_columns(database_path: str, table: str) -> list[str]:
+    connection = sqlite3.connect(database_path)
+    try:
+        rows = connection.execute(f"PRAGMA table_info({table})").fetchall()
+    finally:
+        connection.close()
+    return [row[1] for row in rows]
+
