+async def test_pause_resume_and_cancel_leave_every_selection_untouched() -> None:
+    """Controls are orthogonal to selection, including across runs."""
+    settings = make_settings()
+    catalog = ProviderCatalog(
+        settings,
+        loader=lambda _: FIXTURE_DEFINITIONS,
+        factory=lambda _s, _d, _m: MockLLMProvider(
+            delays_enabled=True,
+            generator_delay=0.001,
+            reviewer_delay=0.03,
+            optimizer_delay=0.001,
+        ),
+    )
+    manager = make_manager(settings=settings, catalog=catalog)
+
+    paused_run = await manager.create_run(
+        create_request(provider_id=ALPHA[0], model_id=ALPHA[1])
+    )
+    await wait_for_status(manager, paused_run.run_id, {RunStatus.REVIEWING})
+    requested = await manager.request_pause(paused_run.run_id)
+    assert requested.status is RunStatus.PAUSE_REQUESTED
+    await wait_for_status(manager, paused_run.run_id, {RunStatus.PAUSED})
+
+    # A second run on a different combination, created and cancelled while the
+    # first one is parked, must not reach into it.
+    cancelled_run = await manager.create_run(
+        create_request(provider_id=BETA[0], model_id=BETA[1])
+    )
+    await manager.cancel_run(cancelled_run.run_id)
+    await wait_for_status(manager, cancelled_run.run_id, {RunStatus.CANCELLED})
+
+    still_paused = await manager.get_run(paused_run.run_id)
+    assert (still_paused.provider_id, still_paused.model_id) == ALPHA
+
+    await manager.resume_run(paused_run.run_id, ResumeRunRequest())
+    result = await manager.wait_for_completion(paused_run.run_id, wait_seconds=10)
+
+    assert result.status is RunStatus.COMPLETED
+    assert (result.provider_id, result.model_id) == ALPHA
+    assert result.provider_display_name == "Fixture Alpha"
+    cancelled = await manager.get_run(cancelled_run.run_id)
+    assert (cancelled.provider_id, cancelled.model_id) == BETA
+    assert cancelled.model_display_name == "Beta 标准模型"
+
