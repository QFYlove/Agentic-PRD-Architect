+class LabelledMockProvider(MockLLMProvider):
+    """A deterministic mock that records that it, specifically, was called."""
+
+    def __init__(self, label: str, log: list[str]) -> None:
+        super().__init__(delays_enabled=False)
+        self.label = label
+        self.log = log
+
+    async def generate_review(self, **kwargs: Any) -> Any:
+        self.log.append(self.label)
+        return await super().generate_review(**kwargs)
+
+
+def labelled_catalog(settings: Settings, log: list[str]) -> ProviderCatalog:
+    """A fixture catalog whose two providers are distinct objects.
+
+    No ``provider_override`` here: binding has to go through the factory so the
+    test can tell which client a run actually executed on.
+    """
+    instances = {
+        "fixture-alpha": LabelledMockProvider("alpha", log),
+        "fixture-beta": LabelledMockProvider("beta", log),
+    }
+    return ProviderCatalog(
+        settings,
+        loader=lambda _: FIXTURE_DEFINITIONS,
+        factory=lambda _s, definition, _m: instances[definition.provider_id],
+    )
+
+
+async def test_concurrent_runs_on_different_combinations_stay_isolated() -> None:
+    log: list[str] = []
+    settings = make_settings()
+    manager = make_manager(settings=settings, catalog=labelled_catalog(settings, log))
+
+    first, second = await asyncio.gather(
+        manager.create_run(create_request(provider_id=ALPHA[0], model_id=ALPHA[1])),
+        manager.create_run(create_request(provider_id=BETA[0], model_id=BETA[1])),
+    )
+    results = await asyncio.gather(
+        manager.wait_for_completion(first.run_id, wait_seconds=10),
+        manager.wait_for_completion(second.run_id, wait_seconds=10),
+    )
+
+    assert [(run.provider_id, run.model_id) for run in results] == [ALPHA, BETA]
+    assert results[0].provider_display_name == "Fixture Alpha"
+    assert results[1].provider_display_name == "Fixture Beta"
+    # Each run executed through its own client, and both really did run.
+    alpha_provider = await manager.provider_for(first.run_id)
+    beta_provider = await manager.provider_for(second.run_id)
+    assert isinstance(alpha_provider, LabelledMockProvider)
+    assert isinstance(beta_provider, LabelledMockProvider)
+    assert alpha_provider.label == "alpha"
+    assert beta_provider.label == "beta"
+    assert alpha_provider is not beta_provider
+    assert {"alpha", "beta"} <= set(log)
