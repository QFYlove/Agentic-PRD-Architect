+def insert_raw_snapshot(database_path: str, payload: dict[str, Any]) -> None:
+    """Write a row exactly as given, bypassing the current model's defaults."""
+    connection = sqlite3.connect(database_path)
+    try:
+        connection.execute(
+            "INSERT INTO runs (run_id, snapshot_json, updated_at) VALUES (?, ?, ?)",
+            (payload["run_id"], json.dumps(payload), payload["updated_at"]),
+        )
+        connection.commit()
+    finally:
+        connection.close()
+
+
+def snapshot_payload_without_selection(run_id: UUID) -> dict[str, Any]:
+    """A snapshot as a pre-Round-2 backend would have written it."""
+    now = utc_now()
+    snapshot = RunSnapshot(
+        run_id=run_id,
+        user_idea="A run recorded before run-level selection existed.",
+        status=RunStatus.COMPLETED,
+        created_at=now,
+        updated_at=now,
+        completed_at=now,
+    )
+    payload = snapshot.model_dump(mode="json")
+    for field in (
+        "provider_id",
+        "model_id",
+        "provider_display_name",
+        "model_display_name",
+    ):
+        del payload[field]
+    return payload
+
