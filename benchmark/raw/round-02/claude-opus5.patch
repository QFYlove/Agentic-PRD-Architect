+# Contracts this feature is not allowed to change
+# --------------------------------------------------------------------------- #
+
+
+def test_no_run_event_type_was_added_for_selection() -> None:
+    """Selection is metadata on a run, not a new thing that happens to it."""
+    assert [member.value for member in RunEventType] == [
+        "run_started",
+        "status_changed",
+        "node_started",
+        "prd_delta",
+        "prd_stream_reset",
+        "prd_generated",
+        "review_completed",
+        "scores_updated",
+        "revision_planned",
+        "pause_requested",
+        "run_paused",
+        "run_resumed",
+        "telemetry_updated",
+        "run_completed",
+        "max_iterations_reached",
+        "run_cancelled",
+        "run_failed",
+    ]
+
+
+async def test_health_and_openapi_keep_their_shape() -> None:
+    app = create_app(
+        settings=make_settings(),
+        provider=MockLLMProvider(delays_enabled=False),
+    )
+    async with await client_for(app) as client:
+        health = await client.get("/api/health")
+        openapi = await client.get("/openapi.json")
+
+    # Unchanged field-for-field: a process-level report, not a run-level one.
+    assert health.json() == {
+        "status": "ok",
+        "mock_mode": True,
+        "provider": "mock",
+    }
+    schema = openapi.json()
+    assert "/api/providers" in schema["paths"]
+    assert "ProviderCatalogResponse" in schema["components"]["schemas"]
+    create_request_schema = schema["components"]["schemas"]["CreateRunRequest"]
+    # Added, not replaced: every legacy field is still there, and both new ones
+    # are optional so a client that never heard of them keeps working.
+    assert {"provider_id", "model_id"} <= set(create_request_schema["properties"])
+    assert "user_idea" in create_request_schema["required"]
+    assert "provider_id" not in create_request_schema.get("required", [])
+    assert "model_id" not in create_request_schema.get("required", [])
+
+
+async def test_catalog_and_mock_output_are_deterministic_across_models() -> None:
+    """The two mock models differ in pacing only, and ordering never wobbles."""
+    app = create_app(
+        settings=make_settings(),
+        provider=None,
+    )
+    async with await client_for(app) as client:
+        first_catalog = await client.get("/api/providers")
+        second_catalog = await client.get("/api/providers")
+    assert first_catalog.json() == second_catalog.json()
+
+    manager = make_manager(settings=make_settings(), catalog=None)
+    standard = await manager.create_run(
+        create_request(
+            provider_id=MOCK_PROVIDER_ID,
+            model_id=MOCK_STANDARD_MODEL_ID,
+        )
+    )
+    fast = await manager.create_run(
+        create_request(provider_id=MOCK_PROVIDER_ID, model_id=MOCK_FAST_MODEL_ID)
+    )
+    standard_result = await manager.wait_for_completion(
+        standard.run_id,
+        wait_seconds=10,
+    )
+    fast_result = await manager.wait_for_completion(fast.run_id, wait_seconds=10)
+
+    assert standard_result.status is fast_result.status is RunStatus.COMPLETED
+    assert standard_result.current_prd == fast_result.current_prd
+    assert [version.evaluation for version in standard_result.versions] == [
+        version.evaluation for version in fast_result.versions
+    ]
+    assert standard_result.model_id == MOCK_STANDARD_MODEL_ID
+    assert fast_result.model_id == MOCK_FAST_MODEL_ID
+
+
+async def test_run_payloads_never_carry_credentials_or_endpoints(
+    tmp_path: Path,
+) -> None:
+    """Checked as raw text over the wire, including the event stream."""
+    settings = make_settings(
+        database_path=str(tmp_path / "safety.sqlite3"),
+        enable_mock_llm=True,
+        deepseek_api_key="sk-deepseek-secret-value",
+        deepseek_base_url="https://internal.deepseek.invalid/v1",
+    )
+    app = create_app(
+        settings=settings,
+        provider=MockLLMProvider(delays_enabled=False),
+    )
+    async with await client_for(app) as client:
+        created = await client.post(
+            "/api/runs",
+            json={
+                "user_idea": "Build a podcast micro-subscription product.",
+                "provider_id": MOCK_PROVIDER_ID,
+                "model_id": MOCK_STANDARD_MODEL_ID,
+            },
+        )
+        run_id = created.json()["run_id"]
+        await app.state.manager.wait_for_completion(UUID(run_id), wait_seconds=10)
+        snapshot = await client.get(f"/api/runs/{run_id}")
+        events = await client.get(f"/api/runs/{run_id}/events?after_sequence=0")
+    await app.state.manager.shutdown()
+
+    for payload in (created.text, snapshot.text, events.text):
+        assert "sk-deepseek-secret-value" not in payload
+        assert "internal.deepseek.invalid" not in payload
+        assert "api_key" not in payload
