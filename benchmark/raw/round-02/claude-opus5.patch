@@ -0,0 +1,1013 @@
+"""Run-level provider/model selection: catalog, validation, binding, persistence.
+
+The through-line of every test here is that a run executes on exactly the
+combination it recorded, and that nothing -- a typo, a removed catalog entry, a
+second concurrent run, a restart -- can quietly move it onto something else.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import sqlite3
+from decimal import Decimal
+from pathlib import Path
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+from httpx import ASGITransport, AsyncClient
+
+from backend.config import ModelPricing, Settings
+from backend.errors import (
+    IncompleteSelectionError,
+    ModelProviderMismatchError,
+    ProviderCatalogUnavailableError,
+    ProviderSelectionUnresolvableError,
+    ProviderUnavailableError,
+    SelectionUnavailableError,
+    UnknownModelError,
+    UnknownProviderError,
+)
+from backend.main import create_app
+from backend.providers.catalog import (
+    MOCK_FAST_MODEL_ID,
+    MOCK_PROVIDER_ID,
+    MOCK_STANDARD_MODEL_ID,
+    ModelDefinition,
+    ProviderCatalog,
+    ProviderDefinition,
+)
+from backend.providers.mock import MockLLMProvider
+from backend.run_manager import RunManager
+from backend.schemas import (
+    CreateRunRequest,
+    ResumeRunRequest,
+    RunEventType,
+    RunSnapshot,
+    RunStatus,
+    utc_now,
+)
+from backend.tests.helpers import (
+    FIXTURE_DEFINITIONS,
+    make_fixture_catalog,
+    make_manager,
+    make_settings,
+    make_sqlite_manager,
+)
+from backend.tests.test_workflow import wait_for_status
+
+ALPHA = ("fixture-alpha", "alpha-standard")
+BETA = ("fixture-beta", "beta-standard")
+
+
+def create_request(**overrides: Any) -> CreateRunRequest:
+    payload: dict[str, Any] = {
+        "user_idea": "Build a podcast micro-subscription product.",
+    }
+    payload.update(overrides)
+    return CreateRunRequest(**payload)
+
+
+def fixture_manager(settings: Settings | None = None) -> RunManager:
+    resolved = settings or make_settings()
+    return make_manager(
+        settings=resolved,
+        catalog=make_fixture_catalog(resolved),
+    )
+
+
+async def client_for(app: object) -> AsyncClient:
+    return AsyncClient(
+        transport=ASGITransport(app=app),  # type: ignore[arg-type]
+        base_url="http://test",
+    )
+
+
+# --------------------------------------------------------------------------- #
+# The safe catalog
+# --------------------------------------------------------------------------- #
+
+
+async def test_catalog_endpoint_lists_only_selectable_combinations() -> None:
+    app = create_app(
+        settings=make_settings(),
+        provider=MockLLMProvider(delays_enabled=False),
+    )
+    async with await client_for(app) as client:
+        response = await client.get("/api/providers")
+
+    assert response.status_code == 200
+    body = response.json()
+    assert list(body) == ["providers"]
+    providers = body["providers"]
+    assert [item["provider_id"] for item in providers] == [MOCK_PROVIDER_ID]
+    assert providers[0]["provider_display_name"]
+    assert [model["model_id"] for model in providers[0]["models"]] == [
+        MOCK_STANDARD_MODEL_ID,
+        MOCK_FAST_MODEL_ID,
+    ]
+    assert all(model["model_display_name"] for model in providers[0]["models"])
+
+
+def test_catalog_response_hides_unavailable_entries() -> None:
+    settings = make_settings()
+    catalog = make_fixture_catalog(
+        settings,
+        definitions=(
+            *FIXTURE_DEFINITIONS,
+            ProviderDefinition(
+                provider_id="fixture-keyless",
+                display_name="Fixture Keyless",
+                models=(ModelDefinition(model_id="keyless-1", display_name="Keyless"),),
+                available=False,
+            ),
+        ),
+    )
+
+    response = catalog.to_response()
+
+    assert [item.provider_id for item in response.providers] == [
+        "fixture-alpha",
+        "fixture-beta",
+    ]
+    # The unavailable model of an available provider is filtered too.
+    assert [model.model_id for model in response.providers[0].models] == [
+        "alpha-standard"
+    ]
+
+
+def test_empty_but_valid_catalog_is_an_empty_list_not_an_error() -> None:
+    settings = make_settings()
+    catalog = ProviderCatalog(settings, loader=lambda _: ())
+
+    assert catalog.to_response().providers == []
+
+
+def test_catalog_load_failure_surfaces_as_an_error() -> None:
+    def broken(_: Settings) -> tuple[ProviderDefinition, ...]:
+        raise RuntimeError("configuration is unreadable")
+
+    catalog = ProviderCatalog(make_settings(), loader=broken)
+
+    with pytest.raises(ProviderCatalogUnavailableError) as error:
