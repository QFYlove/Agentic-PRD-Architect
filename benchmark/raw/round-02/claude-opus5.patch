+    assert result.status is RunStatus.FAILED
+    assert result.error is not None
+    assert result.error.code == "PROVIDER_SELECTION_UNAVAILABLE"
+    assert result.error.retryable is False
+    assert (result.provider_id, result.model_id) == ALPHA
+    assert result.provider_display_name == "Fixture Alpha"
+
+
+# --------------------------------------------------------------------------- #
+# Per-model pricing
+# --------------------------------------------------------------------------- #
+
+
+class PricedFakeProvider(MockLLMProvider):
+    """Deterministic like the mock, but reporting itself as a real provider.
+
+    A mock run's cost is ``0`` by definition, so price lookup can only be
+    exercised by a run that presents as real. Still fully local: no network.
+    """
+
+    is_mock = False
+
+
+def priced_manager(settings: Settings) -> RunManager:
+    return make_manager(
+        settings=settings,
+        catalog=ProviderCatalog(
+            settings,
+            loader=lambda _: FIXTURE_DEFINITIONS,
+            factory=lambda _s, _d, _m: PricedFakeProvider(delays_enabled=False),
+        ),
+    )
+
+
+async def test_cost_uses_the_selected_model_price_and_never_another_model_s() -> None:
+    settings = make_settings(
+        model_prices={
+            "fixture-alpha/alpha-standard": ModelPricing(
+                input_per_million=Decimal("2"),
+                output_per_million=Decimal("8"),
+            ),
+            "fixture-beta/beta-standard": ModelPricing(
+                input_per_million=Decimal("20"),
+                output_per_million=Decimal("80"),
+            ),
+        }
+    )
+    manager = priced_manager(settings)
+
+    alpha_created = await manager.create_run(
+        create_request(provider_id=ALPHA[0], model_id=ALPHA[1])
+    )
+    beta_created = await manager.create_run(
+        create_request(provider_id=BETA[0], model_id=BETA[1])
+    )
+    alpha = await manager.wait_for_completion(alpha_created.run_id, wait_seconds=10)
+    beta = await manager.wait_for_completion(beta_created.run_id, wait_seconds=10)
+
+    assert alpha.total_tokens.total_tokens == beta.total_tokens.total_tokens > 0
+    assert alpha.estimated_cost_usd is not None
+    assert beta.estimated_cost_usd is not None
+    assert alpha.cost_available is True
+    assert beta.cost_available is True
+    # Identical usage, ten times the price: each run was valued at its own rate.
+    assert beta.estimated_cost_usd == pytest.approx(
+        alpha.estimated_cost_usd * 10,
+        rel=1e-4,
+    )
+
+
+async def test_a_model_without_a_price_reports_unknown_and_still_runs() -> None:
+    """Unknown cost is ``None``. Reporting ``0`` would read as "free"."""
+    settings = make_settings(
+        model_prices={
+            "fixture-alpha/alpha-standard": ModelPricing(
+                input_per_million=Decimal("2"),
+                output_per_million=Decimal("8"),
+            )
+        }
+    )
+    manager = priced_manager(settings)
+
+    created = await manager.create_run(
+        create_request(provider_id=BETA[0], model_id=BETA[1])
+    )
+    result = await manager.wait_for_completion(created.run_id, wait_seconds=10)
+
+    assert result.status is RunStatus.COMPLETED
+    assert result.total_tokens.total_tokens > 0
+    assert result.estimated_cost_usd is None
+    assert result.cost_available is False
+
+
