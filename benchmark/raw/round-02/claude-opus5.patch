index 0000000..0759565
--- /dev/null
+++ b/backend/providers/catalog.py
@@ -0,0 +1,376 @@
+"""The backend-owned catalog of provider/model combinations a run may use.
+
+Everything selectable is derived from validated backend configuration here, so
+the frontend has no second authoritative list to drift from, and a caller can
+only ever ask for a combination this process is actually configured to run.
+
+Two things are kept structurally separate:
+
+* ``ProviderDefinition`` / ``ModelDefinition`` hold only safe, public data -- the
+  identifiers and display names the API is allowed to serialize.
+* the credentials and endpoints needed to *execute* a selection are read from
+  ``Settings`` inside the provider factory and never stored on a definition.
+
+That separation is the reason a catalog response cannot leak an API key: there is
+no key on the objects the response is built from.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass
+from typing import Any
+
+from backend.config import ModelPricing, Settings
+from backend.errors import (
+    AppError,
+    IncompleteSelectionError,
+    ModelProviderMismatchError,
+    ProviderCatalogUnavailableError,
+    ProviderUnavailableError,
+    SelectionUnavailableError,
+    UnknownModelError,
+    UnknownProviderError,
+)
+from backend.providers.base import LLMProvider
+from backend.providers.compatible import OpenAICompatibleLLMProvider
+from backend.providers.mock import MockLLMProvider
+from backend.schemas import (
+    ModelOption,
+    ProviderCatalogResponse,
+    ProviderOption,
+)
+
+MOCK_PROVIDER_ID = "mock"
+MOCK_STANDARD_MODEL_ID = "mock-standard"
+MOCK_FAST_MODEL_ID = "mock-fast"
+
+#: Public, non-sensitive metadata only. No prices, no endpoints, no credentials.
+_MOCK_CAPABILITIES: dict[str, Any] = {
+    "streaming": True,
+    "structured_output": True,
+    "deterministic": True,
+}
+_HOSTED_CAPABILITIES: dict[str, Any] = {
+    "streaming": True,
+    "structured_output": True,
+    "deterministic": False,
+}
+
+
+@dataclass(frozen=True)
+class ModelDefinition:
+    """One model, described only by what is safe to publish."""
+
+    model_id: str
+    display_name: str
+    capabilities: dict[str, Any] | None = None
+    available: bool = True
+    """Whether this model can be selected right now.
+
+    A known-but-unavailable entry is deliberately not the same as an unknown one:
+    it stays out of the catalog response, and an explicit request for it is
+    refused as unavailable rather than as a typo.
+    """
+
+
+@dataclass(frozen=True)
+class ProviderDefinition:
+    provider_id: str
+    display_name: str
+    models: tuple[ModelDefinition, ...] = ()
+    available: bool = True
+
+    def find(self, model_id: str) -> ModelDefinition | None:
+        for model in self.models:
+            if model.model_id == model_id:
+                return model
+        return None
+
+
+@dataclass(frozen=True)
+class ResolvedSelection:
+    """A validated combination, plus the creation-time facts a run records."""
+
+    provider_id: str
+    provider_display_name: str
+    model_id: str
+    model_display_name: str
+    pricing: ModelPricing | None = None
+
+
+CatalogLoader = Callable[[Settings], Sequence[ProviderDefinition]]
+ProviderFactory = Callable[
+    [Settings, ProviderDefinition, ModelDefinition],
+    LLMProvider,
+]
+
+
+def build_provider_definitions(settings: Settings) -> tuple[ProviderDefinition, ...]:
+    """The selectable catalog implied by the current configuration.
+
+    Mock mode and hosted mode are disjoint: running a mock selection against a
+    hosted key, or a hosted selection through the deterministic mock, would make
+    the recorded provider a lie about what produced the document.
+    """
+    if settings.enable_mock_llm:
+        return (
+            ProviderDefinition(
+                provider_id=MOCK_PROVIDER_ID,
+                display_name="Mock（本地模拟）",
+                models=(
+                    ModelDefinition(
+                        model_id=MOCK_STANDARD_MODEL_ID,
+                        display_name="Mock 标准模型",
+                        capabilities=dict(_MOCK_CAPABILITIES),
+                    ),
+                    ModelDefinition(
+                        model_id=MOCK_FAST_MODEL_ID,
+                        display_name="Mock 快速模型",
+                        capabilities={**_MOCK_CAPABILITIES, "latency": "low"},
+                    ),
+                ),
+            ),
+        )
+    return (
+        ProviderDefinition(
+            provider_id="deepseek",
+            display_name="DeepSeek",
+            models=(
+                ModelDefinition(
+                    model_id=settings.deepseek_model,
+                    # The configured identifier is the only name the backend
+                    # knows for it; inventing a prettier one would misreport
+                    # which model actually ran.
+                    display_name=settings.deepseek_model,
+                    capabilities=dict(_HOSTED_CAPABILITIES),
+                ),
+            ),
+            available=settings.deepseek_api_key is not None,
+        ),
+        ProviderDefinition(
+            provider_id="glm",
+            display_name="智谱 GLM",
+            models=(
+                ModelDefinition(
+                    model_id=settings.glm_model,
+                    display_name=settings.glm_model,
+                    capabilities=dict(_HOSTED_CAPABILITIES),
+                ),
+            ),
+            available=settings.glm_api_key is not None,
+        ),
+    )
+
+
+def build_provider(
+    settings: Settings,
+    definition: ProviderDefinition,
+    model: ModelDefinition,
+) -> LLMProvider:
+    """Construct the client one resolved combination executes through."""
+    if definition.provider_id == MOCK_PROVIDER_ID:
+        return MockLLMProvider(
+            # The two mock models differ only in pacing: same deterministic
+            # document, same reviews, so a run's output never depends on which
+            # one was picked while the selection still has a visible effect.
+            delays_enabled=(
+                settings.mock_delays_enabled and model.model_id != MOCK_FAST_MODEL_ID
+            ),
+            chunk_size=settings.mock_chunk_size,
+            generator_delay=settings.mock_generator_delay_seconds,
+            reviewer_delay=settings.mock_reviewer_delay_seconds,
+            optimizer_delay=settings.mock_optimizer_delay_seconds,
+        )
+    if definition.provider_id == "deepseek":
+        api_key = settings.deepseek_api_key
+        base_url = settings.deepseek_base_url
+    elif definition.provider_id == "glm":
+        api_key = settings.glm_api_key
+        base_url = settings.glm_base_url
+    else:
+        raise ProviderUnavailableError
+    if api_key is None:
+        raise ProviderUnavailableError
+    return OpenAICompatibleLLMProvider(
+        provider_name=definition.provider_id,
+        api_key=api_key.get_secret_value(),
+        base_url=base_url,
+        model=model.model_id,
+        request_timeout_seconds=settings.llm_request_timeout_seconds,
+        max_output_tokens=settings.llm_max_output_tokens,
+        extra_body={"thinking": {"type": "disabled"}},
+    )
+
+
+class ProviderCatalog:
+    """Read-only catalog plus the resolution rules for a run's selection.
+
+    Shared across runs on purpose -- it holds no "currently selected" state. What
+    a run executes on lives on that run (see ``RunManager``), so two concurrent
+    runs on different combinations cannot influence each other through here.
+    """
+
+    def __init__(
+        self,
+        settings: Settings,
+        *,
+        provider_override: LLMProvider | None = None,
+        loader: CatalogLoader | None = None,
+        factory: ProviderFactory | None = None,
+    ) -> None:
+        self.settings = settings
+        #: An explicitly injected provider (tests, and the E2E scenario mock).
+        #: It answers for every entry so that selection stays real -- validation,
+        #: persistence and binding all still happen -- without the catalog having
+        #: to build a second client for a caller that already supplied one.
+        self._override = provider_override
+        self._loader = loader or build_provider_definitions
+        self._factory = factory or build_provider
+        self._definitions: tuple[ProviderDefinition, ...] | None = None
+        self._instances: dict[tuple[str, str], LLMProvider] = {}
+
+    def definitions(self) -> tuple[ProviderDefinition, ...]:
+        """Every known entry, including the ones that are not selectable.
+
+        A configuration or load failure surfaces as
+        ``PROVIDER_CATALOG_UNAVAILABLE`` rather than as an empty or partial
+        catalog: a caller shown a fabricated list would pick a combination this
+        backend cannot run.
+        """
+        if self._definitions is None:
+            try:
+                self._definitions = tuple(self._loader(self.settings))
+            except AppError:
+                raise
+            except Exception as exc:
+                raise ProviderCatalogUnavailableError from exc
+        return self._definitions
+
+    def to_response(self) -> ProviderCatalogResponse:
+        """The safe, public catalog: only combinations selectable right now."""
+        options: list[ProviderOption] = []
+        for definition in self.definitions():
+            if not definition.available:
+                continue
+            models = [
+                ModelOption(
+                    model_id=model.model_id,
+                    model_display_name=model.display_name,
+                    capabilities=(
+                        dict(model.capabilities)
+                        if model.capabilities is not None
+                        else None
+                    ),
+                )
+                for model in definition.models
+                if model.available
+            ]
+            if not models:
+                continue
+            options.append(
+                ProviderOption(
+                    provider_id=definition.provider_id,
+                    provider_display_name=definition.display_name,
+                    models=models,
+                )
+            )
+        return ProviderCatalogResponse(providers=options)
+
+    def resolve(self, provider_id: str, model_id: str) -> ResolvedSelection:
+        """Validate an explicit combination, or refuse it. Never substitutes."""
+        definitions = self.definitions()
+        definition = next(
+            (item for item in definitions if item.provider_id == provider_id),
+            None,
+        )
+        if definition is None:
+            raise UnknownProviderError
+        model = definition.find(model_id)
+        if model is None:
+            # "Belongs to another provider" and "does not exist" are different
+            # mistakes, and the second one should not be reported as the first.
+            if any(other.find(model_id) is not None for other in definitions):
+                raise ModelProviderMismatchError
+            raise UnknownModelError
+        if not definition.available or not model.available:
+            raise SelectionUnavailableError
+        return ResolvedSelection(
+            provider_id=definition.provider_id,
+            provider_display_name=definition.display_name,
+            model_id=model.model_id,
+            model_display_name=model.display_name,
+            pricing=self.settings.pricing_for(definition.provider_id, model.model_id),
+        )
+
+    def select(
+        self,
+        provider_id: str | None,
+        model_id: str | None,
+    ) -> ResolvedSelection:
+        """Resolve what a create-run request asked for.
+
+        Neither field is the legacy request shape and keeps the configured
+        default. Exactly one field is not a selection at all and is refused.
+        """
+        if provider_id is None and model_id is None:
+            return self.default_selection()
+        if provider_id is None or model_id is None:
+            raise IncompleteSelectionError
+        return self.resolve(provider_id, model_id)
+
+    def default_selection(self) -> ResolvedSelection:
+        """The combination a request with no explicit selection resolves to.
+
+        Kept identical to the pre-selection behaviour: the provider the flat
+        configuration names, with its configured model. Resolved to a concrete
+        pair before the run starts, and failing loudly when the configuration
+        names nothing selectable.
+        """
+        default_provider_id = (
+            MOCK_PROVIDER_ID
+            if self.settings.enable_mock_llm
+            else self.settings.llm_provider
+        )
+        for definition in self.definitions():
+            if definition.provider_id != default_provider_id:
+                continue
+            if not definition.available:
+                continue
+            for model in definition.models:
+                if model.available:
+                    return self.resolve(definition.provider_id, model.model_id)
+        raise ProviderUnavailableError
+
+    def provider_for(self, selection: ResolvedSelection) -> LLMProvider:
+        """The client for one resolved combination, built at most once."""
+        if self._override is not None:
+            return self._override
+        key = (selection.provider_id, selection.model_id)
+        instance = self._instances.get(key)
+        if instance is None:
+            definition = next(
+                (
+                    item
+                    for item in self.definitions()
+                    if item.provider_id == selection.provider_id
+                ),
+                None,
+            )
+            model = definition.find(selection.model_id) if definition else None
+            if definition is None or model is None:
+                raise SelectionUnavailableError
+            instance = self._factory(self.settings, definition, model)
+            self._instances[key] = instance
+        return instance
+
+    @property
+    def default_is_mock(self) -> bool:
+        """Whether the configured default runs against the deterministic mock.
+
+        Only used for the process-level ``/api/health`` report, which predates
+        run-level selection and keeps its original meaning.
+        """
+        if self._override is not None:
+            return self._override.is_mock
+        return self.settings.enable_mock_llm
