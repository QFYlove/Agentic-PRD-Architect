diff --git a/backend/providers/registry.py b/backend/providers/registry.py
new file mode 100644
index 0000000..4e30b3b
--- /dev/null
+++ b/backend/providers/registry.py
@@ -0,0 +1,92 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from decimal import Decimal
+
+from backend.errors import AppError, ProviderUnavailableError
+from backend.providers.base import LLMProvider
+from backend.schemas import (
+    ModelCatalogItem,
+    ProviderCatalogItem,
+    ProviderCatalogResponse,
+)
+
+
+@dataclass(frozen=True)
+class ModelRegistration:
+    model_id: str
+    display_name: str
+    provider: LLMProvider
+    input_price_per_million: Decimal | None = None
+    output_price_per_million: Decimal | None = None
+
+    @property
+    def has_pricing(self) -> bool:
+        return (
+            self.input_price_per_million is not None
+            and self.output_price_per_million is not None
+        )
+
+
+@dataclass(frozen=True)
+class ProviderRegistration:
+    provider_id: str
+    display_name: str
+    models: tuple[ModelRegistration, ...]
+
+
+class ProviderRegistry:
+    def __init__(
+        self,
+        providers: tuple[ProviderRegistration, ...],
+        *,
+        legacy_selection: tuple[str, str],
+    ) -> None:
+        self._providers = providers
+        self.legacy_selection = legacy_selection
+
+    def catalog(self) -> ProviderCatalogResponse:
+        return ProviderCatalogResponse(
+            providers=[
+                ProviderCatalogItem(
+                    provider_id=provider.provider_id,
+                    provider_display_name=provider.display_name,
+                    models=[
+                        ModelCatalogItem(
+                            model_id=model.model_id,
+                            model_display_name=model.display_name,
+                        )
+                        for model in provider.models
+                    ],
+                )
+                for provider in self._providers
+            ]
+        )
+
+    def resolve(
+        self, provider_id: str, model_id: str
+    ) -> tuple[ProviderRegistration, ModelRegistration]:
+        provider = next(
+            (item for item in self._providers if item.provider_id == provider_id),
+            None,
+        )
+        if provider is None:
+            raise AppError(
+                "INVALID_PROVIDER_SELECTION",
+                "The selected provider is not available.",
+                422,
+            )
+        model = next((m for m in provider.models if m.model_id == model_id), None)
+        if model is None:
+            raise AppError(
+                "INVALID_MODEL_SELECTION",
+                "The selected model is not available for this provider.",
+                422,
+            )
+        return provider, model
+
+    def resolve_legacy(self) -> tuple[ProviderRegistration, ModelRegistration]:
+        try:
+            return self.resolve(*self.legacy_selection)
+        except AppError as exc:
+            raise ProviderUnavailableError from exc
