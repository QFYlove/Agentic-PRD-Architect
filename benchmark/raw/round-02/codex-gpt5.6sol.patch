@@ -34,3 +34,21 @@ def estimate_cost(
         usage.output_tokens
     ) * settings.model_output_price_per_million / Decimal(1_000_000)
     return float(cost.quantize(Decimal("0.000001"), rounding=ROUND_HALF_UP))
+
+
+def estimate_model_cost(
+    usage: TokenUsage,
+    input_price_per_million: Decimal | None,
+    output_price_per_million: Decimal | None,
+    *,
+    is_mock: bool,
+) -> float | None:
+    if is_mock:
+        return 0.0
+    if input_price_per_million is None or output_price_per_million is None:
+        return None
+    cost = (
+        Decimal(usage.input_tokens) * input_price_per_million
+        + Decimal(usage.output_tokens) * output_price_per_million
+    ) / Decimal(1_000_000)
+    return float(cost.quantize(Decimal("0.000001"), rounding=ROUND_HALF_UP))
diff --git a/backend/tests/test_provider_selection.py b/backend/tests/test_provider_selection.py
new file mode 100644
index 0000000..93c3d61
--- /dev/null
+++ b/backend/tests/test_provider_selection.py
@@ -0,0 +1,105 @@
+from decimal import Decimal
+
+from backend.main import create_app
+from backend.providers.mock import MockLLMProvider
+from backend.providers.registry import (
+    ModelRegistration,
+    ProviderRegistration,
+    ProviderRegistry,
+)
+from backend.tests.helpers import make_settings
+from backend.tests.test_api import client_for, valid_request
+
+
+def registry() -> ProviderRegistry:
+    provider = MockLLMProvider(delays_enabled=False)
+    return ProviderRegistry(
+        (
+            ProviderRegistration(
+                "safe",
+                "Safe Provider",
+                (
+                    ModelRegistration(
+                        "one", "Model One", provider, Decimal("1"), Decimal("2")
+                    ),
+                    ModelRegistration(
+                        "free", "Free Model", provider, Decimal("0"), Decimal("0")
+                    ),
+                ),
+            ),
+        ),
+        legacy_selection=("safe", "one"),
+    )
+
+
+async def test_catalog_is_safe_and_selection_is_persisted() -> None:
+    app = create_app(
+        settings=make_settings(),
+        provider=MockLLMProvider(delays_enabled=False),
+        provider_registry=registry(),
+    )
+    async with await client_for(app) as client:
+        catalog = await client.get("/api/providers")
+        created = await client.post(
+            "/api/runs", json=valid_request(provider_id="safe", model_id="free")
+        )
+        snapshot = await client.get(f"/api/runs/{created.json()['run_id']}")
+    assert catalog.json() == {
+        "providers": [
+            {
+                "provider_id": "safe",
+                "provider_display_name": "Safe Provider",
+                "models": [
+                    {
+                        "model_id": "one",
+                        "model_display_name": "Model One",
+                        "capabilities": None,
+                    },
+                    {
+                        "model_id": "free",
+                        "model_display_name": "Free Model",
+                        "capabilities": None,
+                    },
+                ],
+            }
+        ]
+    }
+    assert "price" not in catalog.text.lower()
+    assert snapshot.json()["provider_display_name"] == "Safe Provider"
+    assert snapshot.json()["model_display_name"] == "Free Model"
+
+
+async def test_invalid_and_partial_selections_do_not_create_runs() -> None:
+    app = create_app(
+        settings=make_settings(),
+        provider=MockLLMProvider(delays_enabled=False),
+        provider_registry=registry(),
+    )
+    async with await client_for(app) as client:
+        unknown = await client.post(
+            "/api/runs", json=valid_request(provider_id="missing", model_id="one")
+        )
+        mismatch = await client.post(
+            "/api/runs", json=valid_request(provider_id="safe", model_id="missing")
+        )
+        partial = await client.post("/api/runs", json=valid_request(provider_id="safe"))
+        listing = await client.get("/api/runs")
+    assert (unknown.status_code, mismatch.status_code, partial.status_code) == (
+        422,
+        422,
+        422,
+    )
+    assert listing.json()["total"] == 0
+
+
+async def test_legacy_request_resolves_concrete_selection() -> None:
+    app = create_app(
+        settings=make_settings(),
+        provider=MockLLMProvider(delays_enabled=False),
+        provider_registry=registry(),
+    )
+    async with await client_for(app) as client:
+        created = await client.post("/api/runs", json=valid_request())
+        snapshot = await client.get(f"/api/runs/{created.json()['run_id']}")
+    assert snapshot.json()["provider_id"] == "safe"
+    assert snapshot.json()["model_id"] == "one"
