@@ -0,0 +1,120 @@
+import { expect, test } from "@playwright/test";
+
+import {
+  getSnapshot,
+  PODCAST_IDEA,
+  restoreCatalog,
+  setCatalogEmpty,
+  setCatalogError,
+  setScenario,
+  startRun,
+  waitForStatus,
+} from "./helpers";
+
+test.beforeEach(async ({ request }) => {
+  await setScenario(request, "happy");
+});
+
+test.afterEach(async ({ request }) => {
+  await restoreCatalog(request);
+});
+
+test("select provider and model, create run, and observe persisted selection", async ({
+  page,
+  request,
+}) => {
+  const runId = await startRun(page, {
+    providerId: "mock",
+    modelId: "mock-default",
+  });
+  await waitForStatus(page, "已完成");
+
+  const snapshot = await getSnapshot(request, runId);
+  expect(snapshot.provider_id).toBe("mock");
+  expect(snapshot.provider_display_name).toBe("Mock Provider");
+  expect(snapshot.model_id).toBe("mock-default");
+  expect(snapshot.model_display_name).toBe("Mock PRD Model");
+
+  await page.getByTestId("workspace-tab-trace").click();
+  await expect(page.getByText("Mock Provider")).toBeVisible();
+  await expect(page.getByText("Mock PRD Model")).toBeVisible();
+});
+
+test("two concurrent runs keep their own selections", async ({
+  page,
+  request,
+}) => {
+  const firstId = await startRun(page, {
+    idea: `${PODCAST_IDEA} (first)`,
+    providerId: "mock",
+    modelId: "mock-default",
+  });
+  await waitForStatus(page, "已完成");
+
+  await page.getByRole("button", { name: "新建对话" }).click();
+  await expect(
+    page.getByRole("heading", { name: /让每一份需求/ }),
+  ).toBeVisible();
+
+  const secondId = await startRun(page, {
+    idea: `${PODCAST_IDEA} (second)`,
+    providerId: "mock",
+    modelId: "mock-default",
+  });
+  await waitForStatus(page, "已完成");
+
+  const first = await getSnapshot(request, firstId);
+  const second = await getSnapshot(request, secondId);
+  expect(first.provider_id).toBe("mock");
+  expect(second.provider_id).toBe("mock");
+  expect(first.model_id).toBe("mock-default");
+  expect(second.model_id).toBe("mock-default");
+});
+
+test("legacy run navigation still works", async ({ page, request }) => {
+  const runId = await startRun(page);
+  await waitForStatus(page, "已完成");
+
+  const snapshot = await getSnapshot(request, runId);
+  expect(snapshot.provider_id).toBe("mock");
+  expect(snapshot.model_id).toBe("mock-default");
+
+  await page.getByRole("button", { name: "新建对话" }).click();
+  await page
+    .getByRole("button", { name: new RegExp(PODCAST_IDEA) })
+    .first()
+    .click();
+  await expect
+    .poll(() => new URL(page.url()).searchParams.get("run_id"))
+    .toBe(runId);
+  await waitForStatus(page, "已完成");
+});
+
+test("empty catalog blocks creating new runs", async ({ page, request }) => {
+  await setCatalogEmpty(request);
+  await page.goto("/");
+  await expect(
+    page.getByText("当前没有可用的 Provider/Model，无法创建新任务。"),
+  ).toBeVisible();
+  await expect(
+    page.getByRole("button", { name: "开始生成 PRD" }),
+  ).toBeDisabled();
+});
+
+test("failed catalog blocks creating new runs and allows retry", async ({
+  page,
+  request,
+}) => {
+  await setCatalogError(request);
+  await page.goto("/");
+  await expect(
+    page.getByText("加载模型列表失败"),
+  ).toBeVisible();
+  await expect(
+    page.getByRole("button", { name: "开始生成 PRD" }),
+  ).toBeDisabled();
+
+  await restoreCatalog(request);
+  await page.getByRole("button", { name: "重试" }).click();
+  await expect(page.getByTestId("provider-select")).toBeVisible();
+});
