new file mode 100644
index 0000000..63b1dd8
--- /dev/null
+++ b/backend/catalog.py
@@ -0,0 +1,259 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from decimal import Decimal
+from typing import Any
+
+from pydantic import BaseModel, ConfigDict
+
+from backend.config import Settings
+from backend.providers.base import LLMProvider
+from backend.providers.compatible import OpenAICompatibleLLMProvider
+from backend.providers.mock import MockLLMProvider
+from backend.providers.scenario import ScenarioController, ScenarioMockLLMProvider
+
+
+class ModelInfo(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    model_id: str
+    model_display_name: str
+    capabilities: dict[str, Any] | None = None
+
+
+class ProviderInfo(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    provider_id: str
+    provider_display_name: str
+    models: list[ModelInfo]
+
+
+class CatalogResponse(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    providers: list[ProviderInfo]
+
+
+@dataclass(frozen=True)
+class _InternalModelConfig:
+    model_id: str
+    model_display_name: str
+    capabilities: dict[str, Any] | None = None
+    input_price_per_million: Decimal | None = None
+    output_price_per_million: Decimal | None = None
+
+
+@dataclass(frozen=True)
+class _InternalProviderConfig:
+    provider_id: str
+    provider_display_name: str
+    models: dict[str, _InternalModelConfig]
+    api_key: str | None = None
+    base_url: str | None = None
+    extra_body: dict[str, object] | None = None
+
+
+class ProviderCatalogError(Exception):
+    """Catalog configuration or loading failed."""
+
+    pass
+
+
+class ProviderRegistry:
+    """Backend-controlled registry of available providers and models.
+
+    Produces a safe, credential-free catalog for the frontend and can
+    instantiate run-scoped LLM providers from resolved selections.
+    """
+
+    def __init__(
+        self,
+        settings: Settings,
+        scenario_controller: ScenarioController | None = None,
+    ) -> None:
+        self._settings = settings
+        self._scenario_controller = scenario_controller
+        self._providers: dict[str, _InternalProviderConfig] = {}
+        self._test_catalog_override: CatalogResponse | None = None
+        self._test_catalog_error: bool = False
+        self._build_catalog()
+
+    def _build_catalog(self) -> None:
+        if self._settings.enable_mock_llm:
+            mock_models: dict[str, _InternalModelConfig] = {
+                "mock-default": _InternalModelConfig(
+                    model_id="mock-default",
+                    model_display_name="Mock PRD Model",
+                    capabilities=None,
+                    input_price_per_million=Decimal("0"),
+                    output_price_per_million=Decimal("0"),
+                ),
+            }
+            self._providers["mock"] = _InternalProviderConfig(
+                provider_id="mock",
+                provider_display_name="Mock Provider",
+                models=mock_models,
+            )
+        else:
+            if self._settings.llm_provider == "deepseek":
+                if self._settings.deepseek_api_key is None:
+                    raise ProviderCatalogError("DeepSeek API key is not configured")
+                models: dict[str, _InternalModelConfig] = {
+                    self._settings.deepseek_model: _InternalModelConfig(
+                        model_id=self._settings.deepseek_model,
+                        model_display_name=self._settings.deepseek_model,
+                        capabilities=None,
+                        input_price_per_million=self._settings.model_input_price_per_million,
+                        output_price_per_million=self._settings.model_output_price_per_million,
+                    ),
+                }
+                self._providers["deepseek"] = _InternalProviderConfig(
+                    provider_id="deepseek",
+                    provider_display_name="DeepSeek",
+                    models=models,
+                    api_key=self._settings.deepseek_api_key.get_secret_value(),
+                    base_url=self._settings.deepseek_base_url,
+                    extra_body={"thinking": {"type": "disabled"}},
+                )
+            elif self._settings.llm_provider == "glm":
+                if self._settings.glm_api_key is None:
+                    raise ProviderCatalogError("GLM API key is not configured")
+                models = {
+                    self._settings.glm_model: _InternalModelConfig(
+                        model_id=self._settings.glm_model,
+                        model_display_name=self._settings.glm_model,
+                        capabilities=None,
+                        input_price_per_million=self._settings.model_input_price_per_million,
+                        output_price_per_million=self._settings.model_output_price_per_million,
+                    ),
+                }
+                self._providers["glm"] = _InternalProviderConfig(
+                    provider_id="glm",
+                    provider_display_name="GLM",
+                    models=models,
+                    api_key=self._settings.glm_api_key.get_secret_value(),
+                    base_url=self._settings.glm_base_url,
+                )
+
+    def catalog(self) -> CatalogResponse:
+        if self._test_catalog_error:
+            raise ProviderCatalogError("Simulated catalog failure")
+        if self._test_catalog_override is not None:
+            return self._test_catalog_override
+        providers: list[ProviderInfo] = []
+        for cfg in self._providers.values():
+            models = [
+                ModelInfo(
+                    model_id=m.model_id,
+                    model_display_name=m.model_display_name,
+                    capabilities=m.capabilities,
+                )
+                for m in cfg.models.values()
+            ]
+            providers.append(
+                ProviderInfo(
+                    provider_id=cfg.provider_id,
+                    provider_display_name=cfg.provider_display_name,
+                    models=models,
+                )
+            )
+        return CatalogResponse(providers=providers)
+
+    def _test_set_empty(self) -> None:
+        self._test_catalog_override = CatalogResponse(providers=[])
+        self._test_catalog_error = False
+
+    def _test_set_error(self) -> None:
+        self._test_catalog_override = None
+        self._test_catalog_error = True
+
+    def _test_clear_override(self) -> None:
+        self._test_catalog_override = None
+        self._test_catalog_error = False
+
+    def default_selection(self) -> tuple[str, str]:
+        """Return the default provider_id, model_id for legacy requests."""
+        if self._settings.enable_mock_llm:
+            return ("mock", "mock-default")
+        provider = self._settings.llm_provider
+        model = (
+            self._settings.deepseek_model
+            if provider == "deepseek"
+            else self._settings.glm_model
+        )
+        return (provider, model)
+
+    def resolve(self, provider_id: str, model_id: str) -> tuple[str, str, bool]:
+        """Resolve a selection to display names and pricing availability.
+
+        Returns (provider_display_name, model_display_name, has_pricing).
+        Raises ValueError if the selection is invalid.
+        """
+        cfg = self._providers.get(provider_id)
+        if cfg is None:
+            raise ValueError(f"Unknown provider: {provider_id}")
+        model = cfg.models.get(model_id)
+        if model is None:
+            raise ValueError(f"Unknown model '{model_id}' for provider '{provider_id}'")
+        has_pricing = (
+            model.input_price_per_million is not None
+            and model.output_price_per_million is not None
+        )
+        return (cfg.provider_display_name, model.model_display_name, has_pricing)
+
+    def create_provider(
+        self,
+        provider_id: str,
+        model_id: str,
+    ) -> LLMProvider:
+        """Instantiate an LLMProvider for a resolved selection."""
+        cfg = self._providers.get(provider_id)
+        if cfg is None:
+            raise ValueError(f"Unknown provider: {provider_id}")
+        model = cfg.models.get(model_id)
+        if model is None:
+            raise ValueError(f"Unknown model '{model_id}' for provider '{provider_id}'")
+
+        if provider_id == "mock":
+            if self._settings.e2e_test_mode and self._scenario_controller is not None:
+                return ScenarioMockLLMProvider(
+                    controller=self._scenario_controller,
+                    timeout_delay=self._settings.generator_timeout_seconds + 0.5,
+                    delays_enabled=self._settings.mock_delays_enabled,
+                    chunk_size=self._settings.mock_chunk_size,
+                    generator_delay=self._settings.mock_generator_delay_seconds,
+                    reviewer_delay=self._settings.mock_reviewer_delay_seconds,
+                    optimizer_delay=self._settings.mock_optimizer_delay_seconds,
+                    reviewer_stagger=0.4,
+                )
+            return MockLLMProvider(
+                delays_enabled=self._settings.mock_delays_enabled,
+                chunk_size=self._settings.mock_chunk_size,
+                generator_delay=self._settings.mock_generator_delay_seconds,
+                reviewer_delay=self._settings.mock_reviewer_delay_seconds,
+                optimizer_delay=self._settings.mock_optimizer_delay_seconds,
+            )
+
+        assert cfg.api_key is not None
+        assert cfg.base_url is not None
+        has_pricing = (
+            model.input_price_per_million is not None
+            and model.output_price_per_million is not None
+        )
+        return OpenAICompatibleLLMProvider(
+            provider_name=provider_id,
+            api_key=cfg.api_key,
+            base_url=cfg.base_url,
+            model=model_id,
+            request_timeout_seconds=self._settings.llm_request_timeout_seconds,
+            max_output_tokens=self._settings.llm_max_output_tokens,
+            extra_body=cfg.extra_body or {},
+            has_pricing=has_pricing,
+        )
+
+    def is_available(self, provider_id: str, model_id: str) -> bool:
+        cfg = self._providers.get(provider_id)
+        if cfg is None:
+            return False
+        return model_id in cfg.models
