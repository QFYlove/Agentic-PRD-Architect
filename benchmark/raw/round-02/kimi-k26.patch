--- /dev/null
+++ b/src/components/ProviderModelSelector.tsx
@@ -0,0 +1,114 @@
+import { AlertCircle, Loader2 } from "lucide-react";
+import type { CatalogResponse } from "../lib/types";
+
+interface ProviderModelSelectorProps {
+  catalog: CatalogResponse | null;
+  isLoading: boolean;
+  error: string | null;
+  selectedProviderId: string | null;
+  selectedModelId: string | null;
+  onProviderChange(providerId: string | null): void;
+  onModelChange(modelId: string | null): void;
+  onRetry(): void;
+}
+
+export function ProviderModelSelector({
+  catalog,
+  isLoading,
+  error,
+  selectedProviderId,
+  selectedModelId,
+  onProviderChange,
+  onModelChange,
+  onRetry,
+}: ProviderModelSelectorProps) {
+  if (isLoading) {
+    return (
+      <div className="flex items-center gap-2 text-sm text-ink-muted">
+        <Loader2 aria-hidden="true" size={14} className="animate-spin" />
+        <span>正在加载模型列表…</span>
+      </div>
+    );
+  }
+
+  if (error) {
+    return (
+      <div className="flex flex-col gap-2 rounded-panel border border-line bg-surface px-3 py-2">
+        <div className="flex items-center gap-2 text-sm text-danger">
+          <AlertCircle aria-hidden="true" size={14} />
+          <span>加载模型列表失败：{error}</span>
+        </div>
+        <button
+          type="button"
+          className="self-start text-xs font-medium text-accent underline underline-offset-4"
+          onClick={onRetry}
+        >
+          重试
+        </button>
+      </div>
+    );
+  }
+
+  const providers = catalog?.providers ?? [];
+  if (providers.length === 0) {
+    return (
+      <div className="text-sm text-ink-muted">
+        当前没有可用的 Provider/Model，无法创建新任务。
+      </div>
+    );
+  }
+
+  const selectedProvider = providers.find(
+    (p) => p.provider_id === selectedProviderId,
+  );
+  const availableModels = selectedProvider?.models ?? [];
+
+  return (
+    <div className="grid gap-4 sm:grid-cols-2">
+      <label className="block text-sm font-medium text-ink">
+        模型 Provider
+        <select
+          data-testid="provider-select"
+          className="field mt-2"
+          value={selectedProviderId ?? ""}
+          onChange={(event) => {
+            const value = event.target.value || null;
+            onProviderChange(value);
+          }}
+        >
+          <option value="" disabled>
+            选择 Provider
+          </option>
+          {providers.map((provider) => (
+            <option key={provider.provider_id} value={provider.provider_id}>
+              {provider.provider_display_name}
+            </option>
+          ))}
+        </select>
+      </label>
+
+      <label className="block text-sm font-medium text-ink">
+        模型
+        <select
+          data-testid="model-select"
+          className="field mt-2"
+          value={selectedModelId ?? ""}
+          disabled={!selectedProviderId}
+          onChange={(event) => {
+            const value = event.target.value || null;
+            onModelChange(value);
+          }}
+        >
+          <option value="" disabled>
+            {selectedProviderId ? "选择 Model" : "请先选择 Provider"}
+          </option>
+          {availableModels.map((model) => (
+            <option key={model.model_id} value={model.model_id}>
+              {model.model_display_name}
+            </option>
+          ))}
+        </select>
+      </label>
+    </div>
+  );
+}
