+def test_catalog_success_shape() -> None:
+    settings = make_settings()
+    registry = ProviderRegistry(settings)
+    catalog = registry.catalog()
+    assert isinstance(catalog, CatalogResponse)
+    assert len(catalog.providers) == 1
+    provider = catalog.providers[0]
+    assert provider.provider_id == "mock"
+    assert provider.provider_display_name == "Mock Provider"
+    assert len(provider.models) == 1
+    model = provider.models[0]
+    assert model.model_id == "mock-default"
+    assert model.model_display_name == "Mock PRD Model"
+    assert model.capabilities is None
+
+
+def test_catalog_never_exposes_credentials_or_pricing() -> None:
+    settings = make_settings(
+        enable_mock_llm=False,
+        llm_provider="deepseek",
+        deepseek_api_key="sk-test",
+        deepseek_base_url="https://secret.example.com",
+        model_input_price_per_million=Decimal("1.5"),
+        model_output_price_per_million=Decimal("2.0"),
+    )
+    registry = ProviderRegistry(settings)
+    catalog = registry.catalog()
+    dumped = catalog.model_dump(mode="json")
+    dumped_str = str(dumped)
+    assert "sk-test" not in dumped_str
+    assert "secret.example.com" not in dumped_str
+    assert "1.5" not in dumped_str
+    assert "2.0" not in dumped_str
+
+
+def test_catalog_failure_is_not_silenced() -> None:
