+async def test_unavailable_persisted_selection_fails_on_rehydration() -> None:
+    database_path = "test_unavailable.sqlite3"
+    manager = make_sqlite_manager(database_path=database_path)
+    created = await manager.create_run(
+        CreateRunRequest(
+            user_idea="Build a product that later becomes unavailable.",
