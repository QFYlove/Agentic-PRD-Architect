+async def test_old_snapshot_without_provider_fields_loads_safely() -> None:
+    manager = make_manager()
+    created = await manager.create_run(
+        CreateRunRequest(user_idea="Build an old-format product.")
+    )
+    # Simulate an old snapshot by stripping the new fields
+    snapshot = await manager.get_run(created.run_id)
+    raw = snapshot.model_dump(mode="json")
+    del raw["provider_id"]
+    del raw["provider_display_name"]
+    del raw["model_id"]
+    del raw["model_display_name"]
+    old_snapshot = RunSnapshot.model_validate(raw)
+    await manager.run_store.save_unlocked(created.run_id)
+
+    # Reconstruct manager and verify old run loads
+    fresh_manager = make_manager()
+    raw_old = old_snapshot.model_dump_json()
+    await fresh_manager.run_store.create(RunSnapshot.model_validate_json(raw_old))
+    loaded = await fresh_manager.get_run(created.run_id)
+    assert loaded.provider_id is None
+    assert loaded.model_id is None
+    await manager.shutdown()
+    await fresh_manager.shutdown()
